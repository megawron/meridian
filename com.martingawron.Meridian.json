{
  "id": "com.martingawron.Meridian",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "meridian",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--talk-name=org.gnome.evolution.dataserver.Sources5",
    "--talk-name=org.gnome.evolution.dataserver.Calendar8",
    "--talk-name=org.gnome.evolution.dataserver.AddressBook10",
    "--talk-name=org.gnome.evolution.dataserver.Subprocess.Backend.*",
    "--talk-name=org.gnome.OnlineAccounts",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=xdg-run/gvfsd",
    "--metadata=X-DConf=migrate-path=/com/martingawron/meridian/"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "evolution-data-server",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DENABLE_GTK=OFF",
        "-DENABLE_GTK4=ON",
        "-DENABLE_GOA=ON",
        "-DENABLE_OAUTH2_WEBKITGTK=OFF",
        "-DENABLE_OAUTH2_WEBKITGTK4=ON",
        "-DENABLE_WEATHER=OFF",
        "-DENABLE_EXAMPLES=OFF",
        "-DENABLE_VALA_BINDINGS=OFF",
        "-DENABLE_INTROSPECTION=ON",
        "-DWITH_PHONENUMBER=OFF",
        "-DWITH_LIBDB=OFF",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/evolution-data-server.git",
          "commit": "a12493abe06ecaba8207939c8049b7b5b7085ce9"
        }
      ]
    },
    {
      "name": "meridian",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/meridian/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo --offline build --release --locked --manifest-path Cargo.toml --bin meridian",
        "install -Dm755 target/release/meridian /app/bin/meridian",
        "install -Dm644 data/com.martingawron.Meridian.gschema.xml /app/share/glib-2.0/schemas/com.martingawron.Meridian.gschema.xml",
        "glib-compile-schemas /app/share/glib-2.0/schemas",
        "install -Dm644 data/com.martingawron.Meridian.desktop.in /app/share/applications/com.martingawron.Meridian.desktop",
        "install -Dm644 data/com.martingawron.Meridian.Calendar.desktop.in /app/share/applications/com.martingawron.Meridian.Calendar.desktop",
        "install -Dm644 data/com.martingawron.Meridian.metainfo.xml.in /app/share/metainfo/com.martingawron.Meridian.metainfo.xml",
        "for size in 16 22 24 32 48 64 128 256 512 1024; do install -Dm644 data/icons/hicolor/${size}x${size}/apps/com.martingawron.Meridian.png /app/share/icons/hicolor/${size}x${size}/apps/com.martingawron.Meridian.png; done",
        "for svg in data/icons/hicolor/scalable/actions/*.svg; do [ -f \"$svg\" ] && install -Dm644 \"$svg\" \"/app/share/icons/hicolor/scalable/actions/$(basename \"$svg\")\"; done",
        "for svg in data/icons/hicolor/scalable/apps/*.svg; do [ -f \"$svg\" ] && install -Dm644 \"$svg\" \"/app/share/icons/hicolor/scalable/apps/$(basename \"$svg\")\"; done",
        "for po in po/*.po; do [ -f \"$po\" ] || continue; lang=$(basename \"$po\" .po); install -d \"/app/share/locale/${lang}/LC_MESSAGES\"; msgfmt \"$po\" -o \"/app/share/locale/${lang}/LC_MESSAGES/meridian.mo\"; done"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        },
        "cargo-sources.json"
      ]
    }
  ]
}
