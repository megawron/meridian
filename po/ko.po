msgid "Meridian"
msgstr "Meridian"

#: data/com.martingawron.Meridian.Calendar.desktop.in:3
msgid "Calendar and Appointments"
msgstr "달력 및 약속"

#: data/com.martingawron.Meridian.Calendar.desktop.in:4 data/com.martingawron.Meridian.desktop.in:22 src/action_contract.rs:208 src/action_contract.rs:601 and 24 more
msgid "Calendar"
msgstr "달력"

#: data/com.martingawron.Meridian.desktop.in:3
msgid "Mail, Calendar and Contacts"
msgstr "메일, 달력 및 연락처"

#: data/com.martingawron.Meridian.desktop.in:4
msgid "Groupware Client"
msgstr "그룹웨어 클라이언트"

#: data/com.martingawron.Meridian.desktop.in:10
msgid "mail;email;calendar;contacts;groupware;exchange;ews;imap;"
msgstr "mail;email;calendar;contacts;groupware;exchange;ews;imap;메일;이메일;전자메일;달력;연락처;그룹웨어;"

#: data/com.martingawron.Meridian.desktop.in:18 src/dialogs/drafts_dialog.rs:73 src/dialogs/shortcuts_dialog.rs:268
msgid "New Message"
msgstr "새 메시지"

#: data/com.martingawron.Meridian.desktop.in:26 src/action_contract.rs:209 src/action_contract.rs:607 src/dialogs/account_setup_dialog.rs:621 and 16 more
msgid "Contacts"
msgstr "연락처"

#: data/com.martingawron.Meridian.desktop.in:30 src/dialogs/preferences_dialog.rs:8416 src/dialogs/shortcuts_dialog.rs:363
msgid "Tasks & Memos"
msgstr "작업 및 메모"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default window width"
msgstr "기본 창 너비"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default window height"
msgstr "기본 창 높이"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Window maximized state"
msgstr "창 최대화 상태"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Currently selected view tab (mail, calendar, contacts, tasks, memos)"
msgstr "현재 선택된 보기 탭(메일, 달력, 연락처, 작업, 메모)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default mail account or EDS source UID"
msgstr "기본 메일 계정 또는 EDS 소스 UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS calendar, task, or memo source UID"
msgstr "기본 EDS 달력, 작업 또는 메모 소스 UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS task list source UID"
msgstr "기본 EDS 작업 목록 소스 UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS memo list source UID"
msgstr "기본 EDS 메모 목록 소스 UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS address book source UID"
msgstr "기본 EDS 주소록 소스 UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default calendar view (day, week, workweek, month, agenda, year, or list)"
msgstr "기본 달력 보기(일간, 주간, 근무일, 월간, 일정, 연간 또는 목록)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Intervals shown in day and workweek views in minutes (5, 10, 15, 30, or 60)"
msgstr "일간 및 근무일 보기에 표시할 시간 간격(분 단위: 5, 10, 15, 30 또는 60)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Compress weekends in month view"
msgstr "월 보기에서 토요일/일요일은 한 칸에 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether the all-day events header is collapsed in day, week, and workweek views"
msgstr "일간, 주간 및 근무일 보기에서 종일 행사 머리글을 접을지 여부"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Scroll month view by a week instead of a month"
msgstr "월 보기를 한 달 대신 일주일 단위로 스크롤"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Animate month view scrolling"
msgstr "월 보기 스크롤 시 애니메이션 사용"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Smoothly slide rows when scrolling weeks in month view. Disabled automatically when system animations are reduced."
msgstr "월 보기에서 주 단위 스크롤 시 행을 부드럽게 넘깁니다. 시스템 애니메이션이 줄어들면 자동으로 비활성화됩니다."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of weeks shown in month view (5 for compact, 6 to display all months completely)"
msgstr "월 보기에 표시할 주 수(간략 표시는 5, 모든 달을 완전하게 표시하려면 6)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Dim past calendar events"
msgstr "지난 달력 행사 흐리게 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Display past events semi-transparently to distinguish them from upcoming events."
msgstr "지난 행사를 반투명하게 표시하여 다가오는 행사와 구분합니다."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Scaling factor for calendar event chips"
msgstr "달력 행사 칩의 배율"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Multiplier for calendar event chip height, spacing, and typography."
msgstr "달력 행사 칩 높이, 간격 및 글꼴의 배율입니다."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Second time zone for day and workweek views"
msgstr "일간 및 근무일 보기의 두 번째 표준 시간대"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Recently used second time zones"
msgstr "최근에 사용한 두 번째 표준 시간대"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "First weekday shown in calendar grids (monday or sunday)"
msgstr "달력 격자에 표시할 첫 번째 요일(월요일 또는 일요일)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Working weekdays used by the workweek calendar view"
msgstr "근무일 달력 보기에 사용할 근무 요일"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Start of the working day in minutes after midnight"
msgstr "자정 이후 분 단위 근무일 시작 시각"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "End of the working day in minutes after midnight"
msgstr "자정 이후 분 단위 근무일 종료 시각"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default event reminder in minutes before the event"
msgstr "행사 시작 전 분 단위 기본 행사 미리 알림"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Action when clicking a free calendar time slot ('select' to highlight and show draft, 'create' to directly open event editor)"
msgstr "달력 빈 시간대를 클릭할 때 동작('select'는 강조하고 초안 표시, 'create'는 행사 편집기를 바로 열기)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to set a default reminder for appointments"
msgstr "약속에 미리 알림 기본값을 설정할지 여부"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of units for determining a default reminder"
msgstr "기본 미리 알림 여부를 결정할 단위의 개수"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Units for a default reminder, minutes, hours or days"
msgstr "기본 미리 알림 단위(분, 시간 또는 일)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to set a reminder for birthdays and anniversaries"
msgstr "날짜 및 기념일 미리 알림 기본값을 설정할지 여부"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of units for determining a birthday and anniversary reminder"
msgstr "생일 및 기념일 미리 알림을 결정하는 단위 수"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Units for birthday and anniversary reminder, minutes, hours or days"
msgstr "생일 및 기념일 미리 알림 단위(분, 시간 또는 일)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to hide completed tasks in the tasks view"
msgstr "끝마친 작업을 작업 표시할 때 감출지 여부"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Units for determining when to hide completed tasks, minutes, hours or days"
msgstr "완료된 작업을 숨길 시점을 결정하는 단위(분, 시간 또는 일)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of units for determining when to hide completed tasks"
msgstr "완료된 작업을 숨길 시점을 결정하는 단위 수"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to hide cancelled tasks in the tasks view"
msgstr "취소한 작업을 작업 표시할 때 감출지 여부"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to hide cancelled events in the calendar view"
msgstr "달력 보기에서 취소한 행사를 감출지 여부"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show desktop notifications for local reminders"
msgstr "로컬 미리 알림에 대한 데스크톱 알림 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Play sound when reminders are due"
msgstr "미리 알림 시간이 되면 소리 재생"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to play an audible alert when a calendar or task reminder is due."
msgstr "달력 또는 작업 미리 알림 시간이 되면 소리 알림을 재생할지 여부."

#: data/com.martingawron.Meridian.gschema.xml:1 src/dialogs/preferences_dialog.rs:6532
msgid "Show reminders in notification tray only"
msgstr "알림 영역에만 미리 알림 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When set to true, reminders are shown only as desktop notifications; when false, the reminders window is presented immediately."
msgstr "참으로 설정하면 미리 알림이 데스크톱 알림으로만 표시됩니다. 거짓이면 미리 알림 창이 즉시 나타납니다."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ask before destructive actions"
msgstr "되돌릴 수 없는 작업을 실행하기 전에 확인"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show ISO week numbers in calendar views"
msgstr "달력 보기에 ISO 주 번호 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden calendar source UIDs"
msgstr "숨겨진 달력 소스 UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden task list source UIDs"
msgstr "숨겨진 작업 목록 소스 UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden memo list source UIDs"
msgstr "숨겨진 메모 목록 소스 UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden address book source UIDs"
msgstr "숨겨진 주소록 소스 UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden calendar source groups"
msgstr "숨겨진 달력 소스 그룹"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for calendar source groups"
msgstr "달력 소스 그룹의 사용자 지정 표시 순서"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden task list source groups"
msgstr "숨겨진 작업 목록 소스 그룹"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for task list source groups"
msgstr "작업 목록 소스 그룹의 사용자 지정 표시 순서"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden memo list source groups"
msgstr "숨겨진 메모 목록 소스 그룹"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for memo list source groups"
msgstr "메모 목록 소스 그룹의 사용자 지정 표시 순서"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden address book source groups"
msgstr "숨겨진 주소록 소스 그룹"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for address book source groups"
msgstr "주소록 소스 그룹의 사용자 지정 표시 순서"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Calendar date display format (locale, german, iso, or us)"
msgstr "달력 날짜 표시 형식(로캘, 독일식, ISO 또는 미국식)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Calendar time display format (locale, 24h, or 12h)"
msgstr "달력 시간 표시 형식(로캘, 24시간 또는 12시간)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Calendar display time zone (system, UTC, or an IANA identifier)"
msgstr "달력 표시 표준 시간대(시스템, UTC 또는 IANA 식별자)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show Tasks and Memos pane in the Calendar view"
msgstr "작업과 메모 창을 달력 보기에서 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width/position of the Tasks and Memos pane"
msgstr "작업 및 메모 창의 너비/위치"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show Memos section in the Calendar right sidebar"
msgstr "달력 오른쪽 사이드바에 메모 구역 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Place Appointment Details section above Tasks in the Calendar right sidebar"
msgstr "달력 오른쪽 사이드바의 작업 위에 약속 세부 정보 구역 배치"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered panel layout and display modes (off, split, tab) for the Calendar right sidebar"
msgstr "달력 오른쪽 사이드바의 패널 순서 배치 및 표시 모드(off, split, tab)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Secondary splitter position in the Calendar right sidebar when 3 sections are open"
msgstr "3개 구역이 열려 있을 때 달력 오른쪽 사이드바의 보조 구분선 위치"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show appointment details preview pane in the Agenda view"
msgstr "일정 보기에 약속 세부 정보 미리 보기 창 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width/position of the Agenda appointment details preview pane"
msgstr "일정 보기 약속 세부 정보 미리 보기 창의 너비/위치"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show minimalist map preview when hovering over event locations"
msgstr "행사 장소 위에 마우스를 올릴 때 미니 지도 미리 보기 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Open event locations in the configured map service on click"
msgstr "클릭 시 설정된 지도 서비스에서 행사 장소 열기"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Automatically load remote images in HTML emails"
msgstr "HTML 이메일의 외부 이미지 자동으로 불러오기"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Keep mail views in portable offline mode"
msgstr "메일 보기를 휴대용 오프라인 모드로 유지"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Force dark colors in HTML email rendering"
msgstr "HTML 이메일 렌더링 시 어두운 색상 강제 적용"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Adapt HTML email display to dark system theme"
msgstr "어두운 시스템 테마에 맞춰 HTML 이메일 표시 조정"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Render HTML mail bodies"
msgstr "HTML 메일 본문 렌더링"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Use HTML mode when composing new messages"
msgstr "새 메시지를 작성할 때 HTML 모드 사용"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default character encoding for new composed messages"
msgstr "새로 작성하는 메시지의 기본 문자 인코딩"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Request a read receipt for new messages"
msgstr "새 메시지에 대한 수신 확인 요청"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Preferred spell-checking languages (comma-separated, empty for system default)"
msgstr "선호하는 맞춤법 검사 언어(쉼표로 구분, 시스템 기본값은 비워 둠)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the From account selector in composer"
msgstr "작성 창에 보낸 사람 계정 선택기 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the Cc recipient entry in composer"
msgstr "작성 창에 참조(Cc) 수신자 입력란 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the Bcc recipient entry in composer"
msgstr "작성 창에 숨은 참조(Bcc) 수신자 입력란 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the Reply-To entry in composer"
msgstr "작성 창에 회신 주소(Reply-To) 입력란 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the formatting toolbar in composer"
msgstr "작성 창에 서식 도구 모음 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Prompt for confirmation when sending a message with an empty subject"
msgstr "제목이 비어 있는 메시지를 보낼 때 확인 메시지 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Prompt for confirmation when sending a message with only Bcc recipients"
msgstr "숨은 참조 수신자만 있는 메시지를 보낼 때 확인 메시지 표시"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable inline spell-checking in composer"
msgstr "작성 창에서 인라인 맞춤법 검사 사용"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default reply style (quoted, inline, or attach)"
msgstr "기본 답장 스타일(quoted, inline 또는 attach)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default forward style (attached, inline, or quoted)"
msgstr "기본 전달 스타일(attached, inline 또는 quoted)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Insert signature above quoted text when replying"
msgstr "답장할 때 인용된 텍스트 위에 서명 삽입"

#: data/com.martingawron.Meridian.gschema.xml:1
