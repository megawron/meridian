msgstr "Kalender und Termine"

#: data/com.martingawron.Meridian.Calendar.desktop.in:4 data/com.martingawron.Meridian.desktop.in:22 src/action_contract.rs:208 src/action_contract.rs:601 and 24 more
msgid "Calendar"
msgstr "Kalender"

#: data/com.martingawron.Meridian.desktop.in:3
msgid "Mail, Calendar and Contacts"
msgstr "E-Mail, Kalender und Kontakte"

#: data/com.martingawron.Meridian.desktop.in:4
msgid "Groupware Client"
msgstr "Groupware-Client"

#: data/com.martingawron.Meridian.desktop.in:10
msgid "mail;email;calendar;contacts;groupware;exchange;ews;imap;"
msgstr "mail;email;calendar;contacts;groupware;exchange;ews;imap;"

#: data/com.martingawron.Meridian.desktop.in:18 src/dialogs/drafts_dialog.rs:73 src/dialogs/shortcuts_dialog.rs:268
msgid "New Message"
msgstr "Neue Nachricht"

#: data/com.martingawron.Meridian.desktop.in:26 src/action_contract.rs:209 src/action_contract.rs:607 src/dialogs/account_setup_dialog.rs:621 and 16 more
msgid "Contacts"
msgstr "Kontakte"

#: data/com.martingawron.Meridian.desktop.in:30 src/dialogs/preferences_dialog.rs:8416 src/dialogs/shortcuts_dialog.rs:363
msgid "Tasks & Memos"
msgstr "Aufgaben und Notizen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default window width"
msgstr "Standardfensterbreite"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default window height"
msgstr "Standardfensterhöhe"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Window maximized state"
msgstr "Fenster maximiert"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Currently selected view tab (mail, calendar, contacts, tasks, memos)"
msgstr "Aktuell ausgewählter Ansichtsreiter (mail, calendar, contacts, tasks, memos)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default mail account or EDS source UID"
msgstr "Standard-E-Mail-Konto oder EDS-Quellen-UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS calendar, task, or memo source UID"
msgstr "Standard-EDS-Kalender-, Aufgaben- oder Notizquellen-UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS task list source UID"
msgstr "Standard-EDS-Aufgabenlisten-Quellen-UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS memo list source UID"
msgstr "Standard-EDS-Notizlisten-Quellen-UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS address book source UID"
msgstr "Standard-EDS-Adressbuch-Quellen-UID"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default calendar view (day, week, workweek, month, agenda, year, or list)"
msgstr "Standard-Kalenderansicht (day, week, workweek, month, agenda, year oder list)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Intervals shown in day and workweek views in minutes (5, 10, 15, 30, or 60)"
msgstr "In Tages- und Arbeitswochenansicht angezeigte Intervalle in Minuten (5, 10, 15, 30 oder 60)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Compress weekends in month view"
msgstr "Wochenenden in Monatsansicht komprimieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether the all-day events header is collapsed in day, week, and workweek views"
msgstr "Legt fest, ob die Kopfzeile für ganztägige Ereignisse in Tages-, Wochen- und Arbeitswochenansichten eingeklappt ist"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Scroll month view by a week instead of a month"
msgstr "Monatsansicht wochenweise statt monatsweise rollen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Animate month view scrolling"
msgstr "Rollen der Monatsansicht animieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Smoothly slide rows when scrolling weeks in month view. Disabled automatically when system animations are reduced."
msgstr "Zeilen beim Rollen von Wochen in der Monatsansicht sanft verschieben. Wird automatisch deaktiviert, wenn Systemanimationen reduziert sind."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of weeks shown in month view (5 for compact, 6 to display all months completely)"
msgstr "In der Monatsansicht angezeigte Anzahl an Wochen (5 für kompakt, 6 um alle Monate vollständig anzuzeigen)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Dim past calendar events"
msgstr "Vergangene Kalenderereignisse abblenden"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Display past events semi-transparently to distinguish them from upcoming events."
msgstr "Vergangene Ereignisse halbtransparent anzeigen, um sie von bevorstehenden Ereignissen zu unterscheiden."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Scaling factor for calendar event chips"
msgstr "Skalierungsfaktor für Kalenderereignis-Chips"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Multiplier for calendar event chip height, spacing, and typography."
msgstr "Multiplikator für Höhe, Abstand und Typografie von Kalenderereignis-Chips."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Second time zone for day and workweek views"
msgstr "Zweite Zeitzone für Tages- und Arbeitswochenansichten"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Recently used second time zones"
msgstr "Zuletzt verwendete zweite Zeitzonen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "First weekday shown in calendar grids (monday or sunday)"
msgstr "Erster in Kalenderrastern angezeigter Wochentag (monday oder sunday)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Working weekdays used by the workweek calendar view"
msgstr "Von der Arbeitswochenansicht verwendete Arbeitstage"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Start of the working day in minutes after midnight"
msgstr "Beginn des Arbeitstags in Minuten nach Mitternacht"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "End of the working day in minutes after midnight"
msgstr "Ende des Arbeitstags in Minuten nach Mitternacht"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default event reminder in minutes before the event"
msgstr "Standard-Ereigniserinnerung in Minuten vor dem Ereignis"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Action when clicking a free calendar time slot ('select' to highlight and show draft, 'create' to directly open event editor)"
msgstr "Aktion beim Klicken auf ein freies Kalender-Zeitfenster (»select« zum Hervorheben und Entwurf anzeigen, »create« zum direkten Öffnen des Ereigniseditors)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to set a default reminder for appointments"
msgstr "Legt fest, ob eine voreingestellte Erinnerung für Termine festgelegt werden soll"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of units for determining a default reminder"
msgstr "Anzahl der Einheiten zur Festlegung einer voreingestellten Erinnerung"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Units for a default reminder, minutes, hours or days"
msgstr "Einheiten für eine Standarderinnerung: Minuten, Stunden oder Tage"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to set a reminder for birthdays and anniversaries"
msgstr "Legt fest, ob eine Erinnerung für Geburtstage und Jahrestage festgelegt werden soll"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of units for determining a birthday and anniversary reminder"
msgstr "Anzahl der Einheiten zur Festlegung einer Erinnerung für Geburtstage und Jahrestage"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Units for birthday and anniversary reminder, minutes, hours or days"
msgstr "Einheiten für die Erinnerung an Geburtstage und Jahrestage: Minuten, Stunden oder Tage"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to hide completed tasks in the tasks view"
msgstr "Legt fest, ob abgeschlossene Aufgaben in der Aufgabenansicht verborgen werden sollen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Units for determining when to hide completed tasks, minutes, hours or days"
msgstr "Einheiten zur Festlegung, wann abgeschlossene Aufgaben ausgeblendet werden: Minuten, Stunden oder Tage"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of units for determining when to hide completed tasks"
msgstr "Anzahl der Einheiten zur Festlegung, wann abgeschlossene Aufgaben ausgeblendet werden"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to hide cancelled tasks in the tasks view"
msgstr "Legt fest, ob abgebrochene Aufgaben in der Aufgabenansicht verborgen werden sollen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to hide cancelled events in the calendar view"
msgstr "Legt fest, ob abgesagte Termine in der Kalenderansicht verborgen werden sollen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show desktop notifications for local reminders"
msgstr "Schreibtisch-Benachrichtigungen für lokale Erinnerungen anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Play sound when reminders are due"
msgstr "Klang abspielen, wenn Erinnerungen fällig sind"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to play an audible alert when a calendar or task reminder is due."
msgstr "Legt fest, ob ein Signalton abgespielt wird, wenn eine Kalender- oder Aufgabenerinnerung fällig ist."

#: data/com.martingawron.Meridian.gschema.xml:1 src/dialogs/preferences_dialog.rs:6532
msgid "Show reminders in notification tray only"
msgstr "Erinnerungen nur im Benachrichtigungsbereich anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When set to true, reminders are shown only as desktop notifications; when false, the reminders window is presented immediately."
msgstr "Wenn wahr, werden Erinnerungen nur als Schreibtisch-Benachrichtigungen angezeigt; wenn falsch, wird das Erinnerungsfenster sofort dargestellt."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ask before destructive actions"
msgstr "Vor destruktiven Aktionen nachfragen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show ISO week numbers in calendar views"
msgstr "ISO-Wochennummern in Kalenderansichten anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden calendar source UIDs"
msgstr "Ausgeblendete Kalenderquellen-UIDs"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden task list source UIDs"
msgstr "Ausgeblendete Aufgabenlistenquellen-UIDs"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden memo list source UIDs"
msgstr "Ausgeblendete Notizlistenquellen-UIDs"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden address book source UIDs"
msgstr "Ausgeblendete Adressbuchquellen-UIDs"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden calendar source groups"
msgstr "Ausgeblendete Kalenderquellengruppen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for calendar source groups"
msgstr "Benutzerdefinierte Anzeigereihenfolge für Kalenderquellengruppen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden task list source groups"
msgstr "Ausgeblendete Aufgabenlisten-Quellengruppen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for task list source groups"
msgstr "Benutzerdefinierte Anzeigereihenfolge für Aufgabenlisten-Quellengruppen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden memo list source groups"
msgstr "Ausgeblendete Notizlisten-Quellengruppen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for memo list source groups"
msgstr "Benutzerdefinierte Anzeigereihenfolge für Notizlisten-Quellengruppen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden address book source groups"
msgstr "Ausgeblendete Adressbuch-Quellengruppen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for address book source groups"
msgstr "Benutzerdefinierte Anzeigereihenfolge für Adressbuch-Quellengruppen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Calendar date display format (locale, german, iso, or us)"
msgstr "Kalender-Datumsanzeigeformat (locale, german, iso oder us)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Calendar time display format (locale, 24h, or 12h)"
msgstr "Kalender-Zeitanzeigeformat (locale, 24h oder 12h)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Calendar display time zone (system, UTC, or an IANA identifier)"
msgstr "Kalenderanzeige-Zeitzone (system, UTC oder ein IANA-Bezeichner)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show Tasks and Memos pane in the Calendar view"
msgstr "Aufgaben- und Notizen-Fenster in der Kalenderansicht anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width/position of the Tasks and Memos pane"
msgstr "Breite/Position des Aufgaben- und Notizenbereichs"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show Memos section in the Calendar right sidebar"
msgstr "Notizenabschnitt in der rechten Kalenderseitenleiste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Place Appointment Details section above Tasks in the Calendar right sidebar"
msgstr "Termindetails über Aufgaben in der rechten Kalenderseitenleiste platzieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered panel layout and display modes (off, split, tab) for the Calendar right sidebar"
msgstr "Geordnetes Bereichslayout und Anzeigemodi (off, split, tab) für die rechte Kalenderseitenleiste"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Secondary splitter position in the Calendar right sidebar when 3 sections are open"
msgstr "Sekundäre Teilerposition in der rechten Kalenderseitenleiste, wenn 3 Abschnitte geöffnet sind"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show appointment details preview pane in the Agenda view"
msgstr "Termindetails-Vorschaubereich in der Terminübersicht anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width/position of the Agenda appointment details preview pane"
msgstr "Breite/Position des Vorschaubereichs für Termindetails in der Terminübersicht"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show minimalist map preview when hovering over event locations"
msgstr "Minimalistische Kartenvorschau beim Überfahren von Veranstaltungsorten mit der Maus anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Open event locations in the configured map service on click"
msgstr "Veranstaltungsorte beim Klicken im konfigurierten Kartendienst öffnen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Automatically load remote images in HTML emails"
msgstr "Entfernte Bilder in HTML-E-Mails automatisch laden"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Keep mail views in portable offline mode"
msgstr "E-Mail-Ansichten im portablen Offline-Modus halten"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Force dark colors in HTML email rendering"
msgstr "Dunkle Farben bei der HTML-E-Mail-Darstellung erzwingen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Adapt HTML email display to dark system theme"
msgstr "HTML-E-Mail-Anzeige an dunkles System-Farbschema anpassen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Render HTML mail bodies"
msgstr "HTML-E-Mail-Inhalte darstellen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Use HTML mode when composing new messages"
msgstr "HTML-Modus beim Verfassen neuer Nachrichten verwenden"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default character encoding for new composed messages"
msgstr "Standard-Zeichenkodierung für neu verfasste Nachrichten"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Request a read receipt for new messages"
msgstr "Lesebestätigung für neue Nachrichten anfordern"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Preferred spell-checking languages (comma-separated, empty for system default)"
msgstr "Bevorzugte Rechtschreibprüfungs-Sprachen (kommagetrennt, leer für Systemstandard)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the From account selector in composer"
msgstr "Von-Kontoauswahl im Editor anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the Cc recipient entry in composer"
msgstr "Cc-Empfängerfeld im Editor anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the Bcc recipient entry in composer"
msgstr "Bcc-Empfängerfeld im Editor anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the Reply-To entry in composer"
msgstr "Antwort-an-Feld im Editor anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the formatting toolbar in composer"
msgstr "Formatierungswerkzeugleiste im Editor anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Prompt for confirmation when sending a message with an empty subject"
msgstr "Vor dem Senden einer Nachricht mit leerem Betreff nachfragen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Prompt for confirmation when sending a message with only Bcc recipients"
msgstr "Vor dem Senden einer Nachricht mit nur Bcc-Empfängern nachfragen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable inline spell-checking in composer"
msgstr "Direkte Rechtschreibprüfung im Editor aktivieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default reply style (quoted, inline, or attach)"
msgstr "Standard-Antwortstil (quoted, inline oder attach)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default forward style (attached, inline, or quoted)"
msgstr "Standard-Weiterleitungsstil (attached, inline oder quoted)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Insert signature above quoted text when replying"
msgstr "Signatur beim Antworten oberhalb des zitierten Texts einfügen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Prepend signature dash separator (-- ) before signature text"
msgstr "Signaturtrennstrich (-- ) vor Signaturtext voranstellen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Insert signature separator line"
msgstr "Signaturtrennlinie einfügen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom signature separator string"
msgstr "Benutzerdefinierte Signaturtrennzeichenkette"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Track and suggest recently emailed recipients"
msgstr "Zuletzt angeschriebene Empfänger merken und vorschlagen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to remember outgoing message recipients for autocomplete suggestions."
msgstr "Legt fest, ob Empfänger ausgehender Nachrichten für Vorschläge zur automatischen Vervollständigung gemerkt werden sollen."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Font family used for mail and composer text"
msgstr "Schriftfamilie für E-Mail- und Editor-Text"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Font size used for mail and composer text"
msgstr "Schriftgröße für E-Mail- und Editor-Text"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Policy for loading remote images in HTML mail (never, always, sometimes)"
msgstr "Richtlinie zum Laden entfernter Bilder in HTML-E-Mails (never, always, sometimes)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Preserve layout and display placeholder boxes for blocked remote images"
msgstr "Layout beibehalten und Platzhalter für blockierte externe Bilder anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mark a message as read when it is viewed"
msgstr "Eine Nachricht beim Betrachten als gelesen markieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Delay in milliseconds before automatically marking a viewed message as read"
msgstr "Verzögerung in Millisekunden vor dem automatischen Markieren einer betrachteten Nachricht als gelesen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable caret navigation cursor in message viewer"
msgstr "Eingabemarke (Caret-Navigation) im Nachrichtenbetrachter aktivieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Spacebar pages down or advances to next unread message at end"
msgstr "Leertaste blättert seitenweise nach unten oder springt am Ende zur nächsten ungelesenen Nachricht"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Highlight nested quote levels with distinctive colors"
msgstr "Verschachtelte Zitierebenen mit unterschiedlichen Farben hervorheben"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 1st citation level"
msgstr "Rahmenfarbe für 1. Zitierebene"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 2nd citation level"
msgstr "Rahmenfarbe für 2. Zitierebene"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 3rd citation level"
msgstr "Rahmenfarbe für 3. Zitierebene"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 4th citation level"
msgstr "Rahmenfarbe für 4. Zitierebene"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 5th citation level"
msgstr "Rahmenfarbe für 5. Zitierebene"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Collapse message viewer header block to compact form"
msgstr "Nachrichtenbetrachter-Kopfzeilenbereich auf kompakte Form einklappen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show real absolute timestamp in message headers"
msgstr "Echten absoluten Zeitstempel in Nachrichtenkopfzeilen anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mark a message as read when it is selected"
msgstr "Eine Nachricht beim Auswählen als gelesen markieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Delay in milliseconds before automatically marking a selected message as read"
msgstr "Verzögerung in Millisekunden vor dem automatischen Markieren einer ausgewählten Nachricht als gelesen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the selected message preview pane"
msgstr "Vorschaubereich für ausgewählte Nachricht anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show routine mail security status and details"
msgstr "Routinemäßigen E-Mail-Sicherheitsstatus und Details anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the complete RFC822 header block in the mail preview"
msgstr "Vollständigen RFC822-Kopfzeilenblock in der E-Mail-Vorschau anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered normal message headers and their visibility"
msgstr "Geordnete normale Nachrichtenkopfzeilen und deren Sichtbarkeit"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Each entry contains a header field name and whether it is shown in the normal message header view. Disabled entries remain available in Preferences."
msgstr "Jeder Eintrag enthält einen Kopfzeilenfeldnamen und ob er in der normalen Nachrichtenkopfzeilenansicht angezeigt wird. Deaktivierte Einträge bleiben in den Einstellungen verfügbar."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail folder selected when the application starts"
msgstr "Beim Anwendungsstart ausgewählter E-Mail-Ordner"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail layout arrangement"
msgstr "E-Mail-Layoutanordnung"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Arrangement of mail panes: 'vertical' (3-panel: folders, list, preview on right) or 'horizontal' (folders, list above, preview below). Legacy 'modern' and 'classic' are accepted for backwards compatibility."
msgstr "Anordnung der E-Mail-Bereiche: »vertical« (3 Spalten: Ordner, Liste, Vorschau rechts) oder »horizontal« (Ordner, Liste oben, Vorschau unten). Veraltete Werte »modern« und »classic« werden aus Kompatibilitätsgründen akzeptiert."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show today's to-do bar in mail view"
msgstr "Heutige Aufgabenleiste in der E-Mail-Ansicht anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show tasks in agenda sidebar"
msgstr "Aufgaben in der Terminübersicht-Seitenleiste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width of today's to-do bar in mail view"
msgstr "Breite der heutigen Aufgabenleiste in der E-Mail-Ansicht"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Vertical split position between events and tasks in mail agenda sidebar"
msgstr "Vertikale Teilerposition zwischen Ereignissen und Aufgaben in der E-Mail-Terminübersicht-Seitenleiste"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Secondary splitter position in the Mail right sidebar when 3 sections are open"
msgstr "Sekundäre Teilerposition in der rechten E-Mail-Seitenleiste, wenn 3 Abschnitte geöffnet sind"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered panel layout and display modes (off, split, tab, window) for the Mail right sidebar"
msgstr "Geordnetes Bereichslayout und Anzeigemodi (off, split, tab, window) für die rechte E-Mail-Seitenleiste"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the mail toolbar"
msgstr "E-Mail-Werkzeugleiste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show mark read/unread actions in mail toolbar"
msgstr "Aktionen »Als gelesen/ungelesen markieren« in der E-Mail-Werkzeugleiste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show mail and connection status information at the bottom"
msgstr "E-Mail- und Verbindungsstatusinformationen unten anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable developer log console in status bar"
msgstr "Entwickler-Protokollkonsole in der Statusleiste aktivieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the mail folder sidebar"
msgstr "E-Mail-Ordnerseitenleiste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail folder sidebar width"
msgstr "Breite der E-Mail-Ordnerseitenleiste"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Message preview divider in modern mail layout"
msgstr "Nachrichtenvorschau-Teiler im modernen E-Mail-Layout"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Message preview divider in classic mail layout"
msgstr "Nachrichtenvorschau-Teiler im klassischen E-Mail-Layout"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail list density (compact, comfortable, or spacious)"
msgstr "E-Mail-Listendichte (compact, comfortable oder spacious)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show read/unread status indicator in the mail list"
msgstr "Gelesen/Ungelesen-Statusindikator in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show flagged/star indicator in the mail list"
msgstr "Kennzeichnung/Stern-Indikator in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show follow-up flag/completed indicator in the mail list"
msgstr "Wiedervorlage/Erledigt-Indikator in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show sender avatars in the mail list"
msgstr "Absender-Avatare in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Fetch brand logos and domain favicons from the internet"
msgstr "Markenlogos und Domain-Favicons aus dem Internet abrufen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to asynchronously query domain favicons and logos for known sender domains."
msgstr "Legt fest, ob Domain-Favicons und Logos für bekannte Absender-Domains asynchron abgefragt werden sollen."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable unified inboxes and global smart folders in sidebar"
msgstr "Gemeinsame Posteingänge und globale Suchordner in Seitenleiste aktivieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to show aggregated Inboxes, Unread, and Flagged mail virtual folders in the sidebar."
msgstr "Legt fest, ob zusammengefasste virtuelle Ordner für Posteingänge, Ungelesen und Gekennzeichnet in der Seitenleiste angezeigt werden."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show sender names in the mail list"
msgstr "Absendernamen in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show recipient names in the mail list"
msgstr "Empfängernamen in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show message dates in the mail list"
msgstr "Nachrichtendaten in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show an attachment indicator in the mail list"
msgstr "Anhang-Indikator in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show message preview text in the mail list"
msgstr "Nachrichtenvorschautext in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show app-owned labels in the mail list"
msgstr "Anwendungseigene Beschriftungen in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show pure email address instead of name in recipient column"
msgstr "Reine E-Mail-Adresse anstelle des Namens in der Empfängerspalte anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to show email addresses instead of display names in the recipient column."
msgstr "Legt fest, ob E-Mail-Adressen anstelle von Anzeigenamen in der Empfängerspalte angezeigt werden sollen."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "List of mail labels and their associated colors and tags"
msgstr "Liste der E-Mail-Beschriftungen und der zugehörigen Farben und Schlagwörter"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "List of labels known to the mail component. Each entry is in the format name:color[|tag]."
msgstr "Liste der der E-Mail-Komponente bekannten Beschriftungen. Jeder Eintrag hat das Format Name:Farbe[|Schlagwort]."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show message sizes in the mail list"
msgstr "Nachrichtengrößen in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show follow-up due dates in the mail list"
msgstr "Fälligkeitsdaten für Wiedervorlage in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show message locations in the mail list"
msgstr "Nachrichtenorte in der E-Mail-Liste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width of the sender column in the mail list"
msgstr "Breite der Absenderspalte in der E-Mail-Liste"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width of the recipient column in the mail list"
msgstr "Breite der Empfängerspalte in der E-Mail-Liste"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width of the date column in the mail list"
msgstr "Breite der Datumsspalte in der E-Mail-Liste"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Date display format style in the mail list (standard, smart, short, full, datetime, iso, custom)"
msgstr "Datumsanzeigestil in der E-Mail-Liste (standard, smart, short, full, datetime, iso, custom)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom strftime format pattern for dates in the mail list"
msgstr "Benutzerdefiniertes strftime-Formatmuster für Daten in der E-Mail-Liste"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Alignment of the date column in the mail list (right or left)"
msgstr "Ausrichtung der Datumsspalte in der E-Mail-Liste (right oder left)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Active mail list column profile"
msgstr "Aktives E-Mail-Listen-Spaltenprofil"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Style of the email message header (modern card or classic tabular)"
msgstr "Stil des E-Mail-Nachrichtenkopfes (modern card oder classic tabular)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enabled direct action buttons in the mail message header action bar (left_group|right_group)"
msgstr "Aktivierte direkte Aktionsknöpfe in der Aktionsleiste des E-Mail-Nachrichtenkopfes (left_group|right_group)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered items (quick filters, pinned folders, labels, and actions) in the middle-pane mail list action bar"
msgstr "Geordnete Elemente (Schnellfilter, angeheftete Ordner, Beschriftungen und Aktionen) in der mittleren E-Mail-Listen-Aktionsleiste"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Stable ordered mail list column identifiers"
msgstr "Stabile geordnete E-Mail-Listen-Spaltenbezeichner"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Application color scheme (system, light, or dark)"
msgstr "Farbschema der Anwendung (system, light oder dark)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Location of module switcher buttons (top in header bar or bottom-left in sidebar)"
msgstr "Ort der Modulumschalter-Knöpfe (top in der Kopfleiste oder bottom-left in der Seitenleiste)"

#: data/com.martingawron.Meridian.gschema.xml:1 src/dialogs/preferences_dialog.rs:6929
msgid "Sign new messages by default"
msgstr "Neue Mails standardmäßig signieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default OpenPGP key fingerprint"
msgstr "Standard-OpenPGP-Schlüsselfingerabdruck"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default message security protocol (openpgp or smime)"
msgstr "Standard-Nachrichtensicherheitsprotokoll (openpgp oder smime)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default S/MIME signer certificate path"
msgstr "Standard-S/MIME-Unterzeichnerzertifikatspfad"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default S/MIME private key path"
msgstr "Standard-S/MIME-Privatschlüsselpfad"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "S/MIME recipient certificate paths separated by newlines"
msgstr "S/MIME-Empfängerzertifikatspfade, durch Zeilenumbrüche getrennt"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Optional S/MIME trust store certificate bundle path"
msgstr "Optionaler S/MIME-Vertrauensspeicher-Zertifikatsbündelpfad"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail synchronization interval in seconds (0 disables automatic synchronization)"
msgstr "E-Mail-Synchronisierungsintervall in Sekunden (0 deaktiviert die automatische Synchronisierung)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show unread email count in window title bar and tab"
msgstr "Anzahl ungelesener E-Mails in Fenstertitelleiste und Reiter anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Maximum messages loaded per mail folder page"
msgstr "Maximale Anzahl pro E-Mail-Ordnerseite geladener Nachrichten"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Limit in-memory mail cache to reduce RAM usage"
msgstr "E-Mail-Zwischenspeicher im Arbeitsspeicher begrenzen, um RAM-Verbrauch zu reduzieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When false, all locally cached message headers (up to 25,000 per folder) are loaded into memory for instant full-mailbox search and filtering. When true, only mail-sync-message-limit messages per folder are kept in memory initially."
msgstr "Wenn falsch, werden alle lokal zwischengespeicherten Nachrichtenkopfzeilen (bis zu 25.000 pro Ordner) für sofortige Volltextsuche und Filterung in den Arbeitsspeicher geladen. Wenn wahr, werden anfangs nur so viele Nachrichten wie in mail-sync-message-limit festgelegt im Arbeitsspeicher gehalten."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Draft autosave interval in seconds (0 disables local autosave)"
msgstr "Intervall für automatisches Speichern von Entwürfen in Sekunden (0 deaktiviert automatisches Speichern)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Append the configured signature to new messages"
msgstr "Konfigurierte Signatur an neue Nachrichten anhängen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Plain text signature for new messages"
msgstr "Klartext-Signatur für neue Nachrichten"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Directory used for the portable local mail importer"
msgstr "Für den portablen lokalen E-Mail-Importer verwendeter Ordner"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Directory used for the portable iCalendar importer"
msgstr "Für den portablen iCalendar-Importer verwendeter Ordner"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Directory used for the portable vCard importer"
msgstr "Für den portablen vCard-Importer verwendeter Ordner"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Include the original message in replies and forwards"
msgstr "Ursprüngliche Nachricht in Antworten und Weiterleitungen einbinden"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Quote style (blockquote or prefix)"
msgstr "Zitierstil (blockquote oder prefix)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail list sort field (date, subject, sender, unread, flagged, important, or attachments)"
msgstr "E-Mail-Listen-Sortierfeld (date, subject, sender, unread, flagged, important oder attachments)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Sort mail list in descending order"
msgstr "E-Mail-Liste absteigend sortieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Group related messages into conversations"
msgstr "Zusammengehörige Nachrichten zu Unterhaltungen gruppieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Group similar standalone messages from the same sender with the same subject"
msgstr "Ähnliche eigenständige Nachrichten desselben Absenders mit demselben Betreff gruppieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When enabled alongside conversation grouping, recurring notifications or standalone messages sharing the same subject and sender are grouped together even without reply headers."
msgstr "Wenn zusammen mit der Unterhaltungsgruppierung aktiviert, werden wiederkehrende Benachrichtigungen oder eigenständige Nachrichten mit demselben Betreff und Absender auch ohne Antwort-Kopfzeilen zusammen gruppiert."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show conversation thread in viewer as an accordion"
msgstr "Unterhaltungsstrang im Betrachter als Akkordeon anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When enabled, previous messages in a conversation thread are displayed in an expandable accordion inside the preview pane."
msgstr "Wenn aktiviert, werden vorherige Nachrichten in einem Unterhaltungsstrang in einem ausklappbaren Akkordeon im Vorschaubereich angezeigt."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Portable custom folder sibling sort order"
msgstr "Portable benutzerdefinierte Sortierreihenfolge von Ordnergeschwistern"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "JSON map of stable local or loaded remote folder identifiers to their explicit sibling order."
msgstr "JSON-Zuordnung stabiler lokaler oder geladener entfernter Ordnerbezeichner zu ihrer expliziten Geschwisterreihenfolge."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Expanded mail folder and account identifiers"
msgstr "Ausgeklappte E-Mail-Ordner- und Kontenbezeichner"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "List of mail account and folder identifiers that are currently expanded in the folder tree."
msgstr "Liste von E-Mail-Konto- und Ordnerbezeichnern, die derzeit im Ordnerbaum ausgeklappt sind."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show locally deleted messages with a line through them"
msgstr "Lokal gelöschte Nachrichten durchgestrichen anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Move deleted messages to Trash instead of deleting permanently"
msgstr "Gelöschte Nachrichten in den Papierkorb verschieben anstatt dauerhaft zu löschen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When enabled, pressing Delete or clicking the delete action moves selected messages directly to the Trash folder without a confirmation dialog, unless they are already in Trash."
msgstr "Wenn aktiviert, verschiebt das Drücken der Entf-Taste oder das Klicken auf die Löschaktion ausgewählte Nachrichten direkt in den Papierkorb-Ordner ohne Bestätigungsdialog, außer wenn sie sich bereits im Papierkorb befinden."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Initial task filter (including date, status, category, and attachment filters)"
msgstr "Anfänglicher Aufgabenfilter (einschließlich Datums-, Status-, Kategorie- und Anhangfiltern)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Supported values include all, today, next-7, next-30, next-365, important, overdue, in-progress, cancelled, completed, uncompleted, scheduled, no-due, with-attachments, started, and without-category."
msgstr "Unterstützte Werte sind all, today, next-7, next-30, next-365, important, overdue, in-progress, cancelled, completed, uncompleted, scheduled, no-due, with-attachments, started und without-category."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Selected task category filter"
msgstr "Ausgewählter Aufgabenkategoriefilter"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "An empty value shows every category. The value is a validated category name and is combined with the task view filter."
msgstr "Ein leerer Wert zeigt alle Kategorien an. Der Wert ist ein gültiger Kategoriename und wird mit dem Aufgabenansichtsfilter kombiniert."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Task search mode (any field, summary, description, or advanced)"
msgstr "Aufgabensuchmodus (any field, summary, description oder advanced)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Any-field, summary, and description modes search all terms with AND semantics. Advanced mode supports field predicates."
msgstr "Die Modi »Beliebiges Feld«, »Zusammenfassung« und »Beschreibung« suchen alle Begriffe mit UND-Semantik. Der erweiterte Modus unterstützt Feld-Prädikate."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Selected task source filter"
msgstr "Ausgewählter Aufgabenquellenfilter"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Task list sort field (due, title, or priority)"
msgstr "Aufgabenlisten-Sortierfeld (due, title oder priority)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Sort tasks in descending order"
msgstr "Aufgaben absteigend sortieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Memo list sort field (updated, title, or source)"
msgstr "Notizlisten-Sortierfeld (updated, title oder source)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Selected memo source filter"
msgstr "Ausgewählter Notizquellenfilter"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Sort memos in descending order"
msgstr "Notizen absteigend sortieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Memo search mode (summary, description, any field, or advanced)"
msgstr "Notizsuchmodus (summary, description, any field oder advanced)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Advanced memo search accepts only field:value terms joined by AND. Supported fields are summary, description, category, source, and url."
msgstr "Die erweiterte Notizsuche akzeptiert nur mit UND verknüpfte Feld:Wert-Begriffe. Unterstützte Felder sind summary, description, category, source und url."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Memo category filter"
msgstr "Notizkategoriefilter"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Use any, without, or a validated category name."
msgstr "Verwenden Sie »any«, »without« oder einen gültigen Kategorienamen."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the memo preview"
msgstr "Notizvorschau anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the memos toolbar"
msgstr "Notizen-Werkzeugleiste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1 src/views/memos_page.rs:2339
msgid "Memo preview orientation"
msgstr "Notizvorschau-Ausrichtung"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Horizontal memo preview divider position"
msgstr "Horizontale Teilerposition der Notizvorschau"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Vertical memo preview divider position"
msgstr "Vertikale Teilerposition der Notizvorschau"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the task preview"
msgstr "Aufgabenvorschau anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the tasks toolbar"
msgstr "Aufgaben-Werkzeugleiste anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Task preview orientation"
msgstr "Aufgabenvorschau-Ausrichtung"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Horizontal task preview divider position"
msgstr "Horizontale Teilerposition der Aufgabenvorschau"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Vertical task preview divider position"
msgstr "Vertikale Teilerposition der Aufgabenvorschau"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Autocomplete length"
msgstr "Auto-Vervollständigungslänge"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "The number of characters that must be typed before Meridian will attempt to autocomplete."
msgstr "Die Anzahl der Zeichen, die eingegeben werden müssen, bevor Meridian eine automatische Vervollständigung versucht."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show autocompleted name with an address"
msgstr "Legt fest, ob der automatisch vervollständigte Name mit Adresse angezeigt wird"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether force showing the mail address with the name of the autocompleted contact in the entry."
msgstr "Legt fest, ob die E-Mail-Adresse zusammen mit dem Namen des automatisch vervollständigten Kontakts im Eintrag angezeigt wird."

#: data/com.martingawron.Meridian.gschema.xml:1 src/dialogs/preferences_dialog.rs:3131
msgid "Address book sources for autocompletion"
msgstr "Adressbuch-Quellen für Autovervollständigung"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Comma-separated list of address book source UIDs enabled for autocompletion, or empty for all enabled books."
msgstr "Kommagetrennte Liste der für die automatische Vervollständigung aktivierten Adressbuchquellen-UIDs, oder leer für alle aktivierten Bücher."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable address formatting"
msgstr "Adressformatierung aktivieren"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether addresses should be formatted according to standard in their destination country."
msgstr "Legt fest, ob Adressen gemäß dem Standard des Ziellandes formatiert werden sollen."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show maps in contact preview"
msgstr "Karten in der Kontaktvorschau anzeigen"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to show maps in the contact preview pane."
msgstr "Legt fest, ob Karten im Kontaktvorschaubereich angezeigt werden sollen."

