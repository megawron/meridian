i18n.gettext('meridian',
  preset: 'glib',
  args: [
    '--from-code=UTF-8',
    '--add-comments=Translators:',
    '--keyword=gettext',
    '--keyword=ngettext:1,2',
    '--keyword=pgettext:1c,2',
    '--keyword=tr',
    '--keyword=tr!',
    '--keyword=N_',
    '--msgid-bugs-address=https://github.com/megawron/meridian/issues',
  ],
)
