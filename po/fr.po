#: data/com.martingawron.Meridian.Calendar.desktop.in:2 data/com.martingawron.Meridian.desktop.in:2 data/com.martingawron.Meridian.metainfo.xml.in:1
msgid "Meridian"
msgstr "Meridian"

#: data/com.martingawron.Meridian.Calendar.desktop.in:3
msgid "Calendar and Appointments"
msgstr "Agenda et rendez-vous"

#: data/com.martingawron.Meridian.Calendar.desktop.in:4 data/com.martingawron.Meridian.desktop.in:22 src/action_contract.rs:208 src/action_contract.rs:601 and 24 more
msgid "Calendar"
msgstr "Agenda"

#: data/com.martingawron.Meridian.desktop.in:3
msgid "Mail, Calendar and Contacts"
msgstr "Courriel, agenda et contacts"

#: data/com.martingawron.Meridian.desktop.in:4
msgid "Groupware Client"
msgstr "Client de travail collaboratif"

#: data/com.martingawron.Meridian.desktop.in:10
msgid "mail;email;calendar;contacts;groupware;exchange;ews;imap;"
msgstr "courriel;email;agenda;calendrier;contacts;groupware;exchange;ews;imap;"

#: data/com.martingawron.Meridian.desktop.in:18 src/dialogs/drafts_dialog.rs:73 src/dialogs/shortcuts_dialog.rs:268
msgid "New Message"
msgstr "Nouveau message"

#: data/com.martingawron.Meridian.desktop.in:26 src/action_contract.rs:209 src/action_contract.rs:607 src/dialogs/account_setup_dialog.rs:621 and 16 more
msgid "Contacts"
msgstr "Contacts"

#: data/com.martingawron.Meridian.desktop.in:30 src/dialogs/preferences_dialog.rs:8416 src/dialogs/shortcuts_dialog.rs:363
msgid "Tasks & Memos"
msgstr "Tâches et mémos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default window width"
msgstr "Largeur de fenêtre par défaut"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default window height"
msgstr "Hauteur de fenêtre par défaut"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Window maximized state"
msgstr "État maximisé de la fenêtre"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Currently selected view tab (mail, calendar, contacts, tasks, memos)"
msgstr "Onglet de vue actuellement sélectionné (courriel, agenda, contacts, tâches, mémos)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default mail account or EDS source UID"
msgstr "Compte de courriel ou UID de source EDS par défaut"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS calendar, task, or memo source UID"
msgstr "UID de source d'agenda, de tâche ou de mémo EDS par défaut"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS task list source UID"
msgstr "UID de source de liste de tâches EDS par défaut"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS memo list source UID"
msgstr "UID de source de liste de mémos EDS par défaut"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS address book source UID"
msgstr "UID de source de carnet d'adresses EDS par défaut"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default calendar view (day, week, workweek, month, agenda, year, or list)"
msgstr "Vue d'agenda par défaut (jour, semaine, semaine ouvrée, mois, agenda, année ou liste)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Intervals shown in day and workweek views in minutes (5, 10, 15, 30, or 60)"
msgstr "Intervalles affichés dans les vues par jour et semaine ouvrée en minutes (5, 10, 15, 30 ou 60)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Compress weekends in month view"
msgstr "Compresser les week-ends dans la vue mensuelle"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether the all-day events header is collapsed in day, week, and workweek views"
msgstr "Indique si l'en-tête des événements sur toute la journée est replié dans les vues par jour, semaine et semaine ouvrée"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Scroll month view by a week instead of a month"
msgstr "Faire défiler la vue mensuelle par semaine plutôt que par mois"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Animate month view scrolling"
msgstr "Animer le défilement de la vue mensuelle"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Smoothly slide rows when scrolling weeks in month view. Disabled automatically when system animations are reduced."
msgstr "Faire glisser les lignes en douceur lors du défilement des semaines dans la vue mensuelle. Désactivé automatiquement lorsque les animations système sont réduites."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of weeks shown in month view (5 for compact, 6 to display all months completely)"
msgstr "Nombre de semaines affichées dans la vue mensuelle (5 pour compact, 6 pour afficher tous les mois complètement)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Dim past calendar events"
msgstr "Assombrir les événements passés de l'agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Display past events semi-transparently to distinguish them from upcoming events."
msgstr "Afficher les événements passés en semi-transparence pour les distinguer des événements à venir."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Scaling factor for calendar event chips"
msgstr "Facteur d'échelle pour les pastilles d'événements de l'agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Multiplier for calendar event chip height, spacing, and typography."
msgstr "Multiplicateur pour la hauteur, l'espacement et la typographie des pastilles d'événements de l'agenda."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Second time zone for day and workweek views"
msgstr "Deuxième fuseau horaire pour les vues par jour et semaine ouvrée"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Recently used second time zones"
msgstr "Deuxièmes fuseaux horaires récemment utilisés"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "First weekday shown in calendar grids (monday or sunday)"
msgstr "Premier jour de la semaine affiché dans les grilles d'agenda (lundi ou dimanche)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Working weekdays used by the workweek calendar view"
msgstr "Jours ouvrés utilisés par la vue de la semaine ouvrée de l'agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Start of the working day in minutes after midnight"
msgstr "Début de la journée de travail en minutes après minuit"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "End of the working day in minutes after midnight"
msgstr "Fin de la journée de travail en minutes après minuit"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default event reminder in minutes before the event"
msgstr "Rappel d'événement par défaut en minutes avant l'événement"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Action when clicking a free calendar time slot ('select' to highlight and show draft, 'create' to directly open event editor)"
msgstr "Action lors du clic sur un créneau libre de l'agenda (« select » pour surligner et afficher le brouillon, « create » pour ouvrir directement l'éditeur d'événement)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to set a default reminder for appointments"
msgstr "Indique s’il faut mettre en place un rappel par défaut des rendez-vous"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of units for determining a default reminder"
msgstr "Nombre d’unités pour déterminer un rappel par défaut"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Units for a default reminder, minutes, hours or days"
msgstr "Unités pour un rappel par défaut, minutes, heures ou jours"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to set a reminder for birthdays and anniversaries"
msgstr "Indique s’il faut mettre en place un rappel pour les anniversaires"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of units for determining a birthday and anniversary reminder"
msgstr "Nombre d'unités pour déterminer un rappel d'anniversaire"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Units for birthday and anniversary reminder, minutes, hours or days"
msgstr "Unités pour le rappel d'anniversaire, minutes, heures ou jours"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to hide completed tasks in the tasks view"
msgstr "Indique s’il faut masquer les tâches terminées dans la vue des tâches"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Units for determining when to hide completed tasks, minutes, hours or days"
msgstr "Unités pour déterminer quand masquer les tâches terminées, minutes, heures ou jours"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of units for determining when to hide completed tasks"
msgstr "Nombre d'unités pour déterminer quand masquer les tâches terminées"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to hide cancelled tasks in the tasks view"
msgstr "Indique s’il faut masquer les tâches annulées dans la vue des tâches"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to hide cancelled events in the calendar view"
msgstr "Indique s’il faut cacher les évènements annulés dans la vue de l’agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show desktop notifications for local reminders"
msgstr "Afficher les notifications du bureau pour les rappels locaux"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Play sound when reminders are due"
msgstr "Émettre un son lorsque les rappels arrivent à échéance"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to play an audible alert when a calendar or task reminder is due."
msgstr "Indique s'il faut émettre une alerte sonore lorsqu'un rappel d'agenda ou de tâche arrive à échéance."

#: data/com.martingawron.Meridian.gschema.xml:1 src/dialogs/preferences_dialog.rs:6532
msgid "Show reminders in notification tray only"
msgstr "Afficher les rappels dans le tiroir de notification uniquement"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When set to true, reminders are shown only as desktop notifications; when false, the reminders window is presented immediately."
msgstr "Lorsque défini à vrai, les rappels sont affichés uniquement sous forme de notifications de bureau ; lorsque faux, la fenêtre des rappels est présentée immédiatement."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ask before destructive actions"
msgstr "Demander confirmation avant les actions destructrices"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show ISO week numbers in calendar views"
msgstr "Afficher les numéros de semaine ISO dans les vues d'agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden calendar source UIDs"
msgstr "UID des sources d'agenda masquées"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden task list source UIDs"
msgstr "UID des sources de liste de tâches masquées"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden memo list source UIDs"
msgstr "UID des sources de liste de mémos masquées"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden address book source UIDs"
msgstr "UID des sources de carnet d'adresses masquées"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden calendar source groups"
msgstr "Groupes de sources d'agenda masqués"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for calendar source groups"
msgstr "Ordre d'affichage personnalisé des groupes de sources d'agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden task list source groups"
msgstr "Groupes de sources de liste de tâches masqués"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for task list source groups"
msgstr "Ordre d'affichage personnalisé des groupes de sources de liste de tâches"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden memo list source groups"
msgstr "Groupes de sources de liste de mémos masqués"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for memo list source groups"
msgstr "Ordre d'affichage personnalisé des groupes de sources de liste de mémos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden address book source groups"
msgstr "Groupes de sources de carnet d'adresses masqués"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for address book source groups"
msgstr "Ordre d'affichage personnalisé des groupes de sources de carnet d'adresses"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Calendar date display format (locale, german, iso, or us)"
msgstr "Format d'affichage de la date dans l'agenda (locale, german, iso ou us)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Calendar time display format (locale, 24h, or 12h)"
msgstr "Format d'affichage de l'heure dans l'agenda (locale, 24h ou 12h)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Calendar display time zone (system, UTC, or an IANA identifier)"
msgstr "Fuseau horaire d'affichage de l'agenda (système, UTC ou identifiant IANA)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show Tasks and Memos pane in the Calendar view"
msgstr "Afficher le panneau de Tâches et de Mémos dans la vue de l’agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width/position of the Tasks and Memos pane"
msgstr "Largeur/position du panneau Tâches et mémos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show Memos section in the Calendar right sidebar"
msgstr "Afficher la section Mémos dans la barre latérale droite de l'agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Place Appointment Details section above Tasks in the Calendar right sidebar"
msgstr "Placer la section Détails du rendez-vous au-dessus des tâches dans la barre latérale droite de l'agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered panel layout and display modes (off, split, tab) for the Calendar right sidebar"
msgstr "Disposition ordonnée des panneaux et modes d'affichage (off, split, tab) pour la barre latérale droite de l'agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Secondary splitter position in the Calendar right sidebar when 3 sections are open"
msgstr "Position du séparateur secondaire dans la barre latérale droite de l'agenda lorsque 3 sections sont ouvertes"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show appointment details preview pane in the Agenda view"
msgstr "Afficher le panneau d'aperçu des détails du rendez-vous dans la vue Agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width/position of the Agenda appointment details preview pane"
msgstr "Largeur/position du panneau d'aperçu des détails du rendez-vous de la vue Agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show minimalist map preview when hovering over event locations"
msgstr "Afficher un aperçu cartographique minimaliste au survol des lieux d'événements"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Open event locations in the configured map service on click"
msgstr "Ouvrir les lieux d'événements dans le service cartographique configuré lors d'un clic"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Automatically load remote images in HTML emails"
msgstr "Charger automatiquement les images distantes dans les courriels HTML"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Keep mail views in portable offline mode"
msgstr "Conserver les vues de courriel en mode hors ligne portable"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Force dark colors in HTML email rendering"
msgstr "Forcer les couleurs sombres lors du rendu des courriels HTML"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Adapt HTML email display to dark system theme"
msgstr "Adapter l'affichage des courriels HTML au thème sombre du système"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Render HTML mail bodies"
msgstr "Effectuer le rendu des corps de courriel HTML"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Use HTML mode when composing new messages"
msgstr "Utiliser le mode HTML lors de la rédaction de nouveaux messages"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default character encoding for new composed messages"
msgstr "Codage de caractères par défaut pour les nouveaux messages rédigés"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Request a read receipt for new messages"
msgstr "Demander un accusé de réception pour les nouveaux messages"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Preferred spell-checking languages (comma-separated, empty for system default)"
msgstr "Langues de vérification orthographique préférées (séparées par des virgules, vide pour la valeur système par défaut)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the From account selector in composer"
msgstr "Afficher le sélecteur de compte expéditeur (De) dans l'éditeur"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the Cc recipient entry in composer"
msgstr "Afficher le champ de destinataire Cc dans l'éditeur"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the Bcc recipient entry in composer"
msgstr "Afficher le champ de destinataire Cci dans l'éditeur"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the Reply-To entry in composer"
msgstr "Afficher le champ Répondre à dans l'éditeur"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the formatting toolbar in composer"
msgstr "Afficher la barre d'outils de mise en forme dans l'éditeur"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Prompt for confirmation when sending a message with an empty subject"
msgstr "Demander confirmation lors de l'envoi d'un message sans objet"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Prompt for confirmation when sending a message with only Bcc recipients"
msgstr "Demander confirmation lors de l'envoi d'un message avec uniquement des destinataires en Cci"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable inline spell-checking in composer"
msgstr "Activer la vérification orthographique en cours de saisie dans l'éditeur"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default reply style (quoted, inline, or attach)"
msgstr "Style de réponse par défaut (cité, intégré ou en pièce jointe)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default forward style (attached, inline, or quoted)"
msgstr "Style de transfert par défaut (en pièce jointe, intégré ou cité)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Insert signature above quoted text when replying"
msgstr "Insérer la signature au-dessus du texte cité lors d'une réponse"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Prepend signature dash separator (-- ) before signature text"
msgstr "Préfixer le texte de la signature par le séparateur tirets (-- )"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Insert signature separator line"
msgstr "Insérer une ligne séparatrice de signature"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom signature separator string"
msgstr "Chaîne séparatrice de signature personnalisée"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Track and suggest recently emailed recipients"
msgstr "Mémoriser et suggérer les destinataires récents des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to remember outgoing message recipients for autocomplete suggestions."
msgstr "Indique s'il faut mémoriser les destinataires des messages sortants pour les suggestions de saisie semi-automatique."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Font family used for mail and composer text"
msgstr "Police de caractères utilisée pour le texte des courriels et de l'éditeur"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Font size used for mail and composer text"
msgstr "Taille de police utilisée pour le texte des courriels et de l'éditeur"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Policy for loading remote images in HTML mail (never, always, sometimes)"
msgstr "Politique de chargement des images distantes dans les courriels HTML (jamais, toujours, parfois)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Preserve layout and display placeholder boxes for blocked remote images"
msgstr "Préserver la mise en page et afficher des cadres de substitution pour les images distantes bloquées"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mark a message as read when it is viewed"
msgstr "Marquer un message comme lu lorsqu'il est affiché"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Delay in milliseconds before automatically marking a viewed message as read"
msgstr "Délai en millisecondes avant de marquer automatiquement comme lu un message affiché"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable caret navigation cursor in message viewer"
msgstr "Activer le curseur de navigation au clavier dans la visionneuse de messages"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Spacebar pages down or advances to next unread message at end"
msgstr "La barre d'espace fait défiler d'une page vers le bas ou passe au prochain message non lu à la fin"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Highlight nested quote levels with distinctive colors"
msgstr "Mettre en surbrillance les niveaux de citation imbriqués avec des couleurs distinctes"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 1st citation level"
msgstr "Couleur de bordure pour le 1er niveau de citation"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 2nd citation level"
msgstr "Couleur de bordure pour le 2e niveau de citation"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 3rd citation level"
msgstr "Couleur de bordure pour le 3e niveau de citation"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 4th citation level"
msgstr "Couleur de bordure pour le 4e niveau de citation"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 5th citation level"
msgstr "Couleur de bordure pour le 5e niveau de citation"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Collapse message viewer header block to compact form"
msgstr "Replier le bloc d'en-tête de la visionneuse de messages au format compact"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show real absolute timestamp in message headers"
msgstr "Afficher l'horodatage absolu réel dans les en-têtes de message"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mark a message as read when it is selected"
msgstr "Marquer un message comme lu lorsqu'il est sélectionné"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Delay in milliseconds before automatically marking a selected message as read"
msgstr "Délai en millisecondes avant de marquer automatiquement comme lu un message sélectionné"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the selected message preview pane"
msgstr "Afficher le panneau d'aperçu du message sélectionné"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show routine mail security status and details"
msgstr "Afficher l'état de sécurité habituel du courriel et ses détails"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the complete RFC822 header block in the mail preview"
msgstr "Afficher le bloc d'en-tête RFC822 complet dans l'aperçu du courriel"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered normal message headers and their visibility"
msgstr "En-têtes de message normaux ordonnés et leur visibilité"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Each entry contains a header field name and whether it is shown in the normal message header view. Disabled entries remain available in Preferences."
msgstr "Chaque entrée contient un nom de champ d'en-tête et indique s'il est affiché dans la vue normale des en-têtes. Les entrées désactivées restent disponibles dans les Préférences."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail folder selected when the application starts"
msgstr "Dossier de courriel sélectionné au démarrage de l'application"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail layout arrangement"
msgstr "Disposition des panneaux de courriel"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Arrangement of mail panes: 'vertical' (3-panel: folders, list, preview on right) or 'horizontal' (folders, list above, preview below). Legacy 'modern' and 'classic' are accepted for backwards compatibility."
msgstr "Disposition des panneaux de courriel : « vertical » (3 panneaux : dossiers, liste, aperçu à droite) ou « horizontal » (dossiers, liste au-dessus, aperçu en dessous). Les valeurs historiques « modern » et « classic » sont acceptées pour la compatibilité descendante."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show today's to-do bar in mail view"
msgstr "Afficher la barre des tâches du jour dans la vue de courriel"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show tasks in agenda sidebar"
msgstr "Afficher les tâches dans la barre latérale de l'agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width of today's to-do bar in mail view"
msgstr "Largeur de la barre des tâches du jour dans la vue de courriel"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Vertical split position between events and tasks in mail agenda sidebar"
msgstr "Position du séparateur vertical entre événements et tâches dans la barre latérale d'agenda du courriel"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Secondary splitter position in the Mail right sidebar when 3 sections are open"
msgstr "Position du séparateur secondaire dans la barre latérale droite du courriel lorsque 3 sections sont ouvertes"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered panel layout and display modes (off, split, tab, window) for the Mail right sidebar"
msgstr "Disposition ordonnée des panneaux et modes d'affichage (off, split, tab, window) pour la barre latérale droite du courriel"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the mail toolbar"
msgstr "Afficher la barre d'outils du courriel"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show mark read/unread actions in mail toolbar"
msgstr "Afficher les actions marquer lu/non lu dans la barre d'outils du courriel"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show mail and connection status information at the bottom"
msgstr "Afficher les informations d'état du courriel et de connexion en bas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable developer log console in status bar"
msgstr "Activer la console de journal de développement dans la barre d'état"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the mail folder sidebar"
msgstr "Afficher la barre latérale des dossiers de courriel"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail folder sidebar width"
msgstr "Largeur de la barre latérale des dossiers de courriel"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Message preview divider in modern mail layout"
msgstr "Séparateur d'aperçu de message dans la disposition de courriel moderne"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Message preview divider in classic mail layout"
msgstr "Séparateur d'aperçu de message dans la disposition de courriel classique"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail list density (compact, comfortable, or spacious)"
msgstr "Densité de la liste des courriels (compacte, confortable ou aérée)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show read/unread status indicator in the mail list"
msgstr "Afficher l'indicateur d'état lu/non lu dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show flagged/star indicator in the mail list"
msgstr "Afficher l'indicateur de suivi/étoile dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show follow-up flag/completed indicator in the mail list"
msgstr "Afficher l'indicateur d'indicateur de suivi/terminé dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show sender avatars in the mail list"
msgstr "Afficher les avatars des expéditeurs dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Fetch brand logos and domain favicons from the internet"
msgstr "Récupérer les logos de marque et les favicons de domaine sur Internet"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to asynchronously query domain favicons and logos for known sender domains."
msgstr "Indique s'il faut demander de façon asynchrone les favicons et logos de domaine pour les domaines d'expéditeurs connus."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable unified inboxes and global smart folders in sidebar"
msgstr "Activer les boîtes de réception unifiées et les dossiers intelligents globaux dans la barre latérale"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to show aggregated Inboxes, Unread, and Flagged mail virtual folders in the sidebar."
msgstr "Indique s'il faut afficher les dossiers virtuels agrégés Boîtes de réception, Non lus et Suivis dans la barre latérale."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show sender names in the mail list"
msgstr "Afficher les noms des expéditeurs dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show recipient names in the mail list"
msgstr "Afficher les noms des destinataires dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show message dates in the mail list"
msgstr "Afficher les dates des messages dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show an attachment indicator in the mail list"
msgstr "Afficher un indicateur de pièce jointe dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show message preview text in the mail list"
msgstr "Afficher le texte d'aperçu du message dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show app-owned labels in the mail list"
msgstr "Afficher les étiquettes de l'application dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show pure email address instead of name in recipient column"
msgstr "Afficher l'adresse électronique brute au lieu du nom dans la colonne des destinataires"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to show email addresses instead of display names in the recipient column."
msgstr "Indique s'il faut afficher les adresses électroniques au lieu des noms affichés dans la colonne des destinataires."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "List of mail labels and their associated colors and tags"
msgstr "Liste des étiquettes de courriel et de leurs couleurs et balises associées"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "List of labels known to the mail component. Each entry is in the format name:color[|tag]."
msgstr "Liste des étiquettes connues du composant de courriel. Chaque entrée est au format nom:couleur[|balise]."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show message sizes in the mail list"
msgstr "Afficher la taille des messages dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show follow-up due dates in the mail list"
msgstr "Afficher les dates d'échéance de suivi dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show message locations in the mail list"
msgstr "Afficher l'emplacement des messages dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width of the sender column in the mail list"
msgstr "Largeur de la colonne de l'expéditeur dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width of the recipient column in the mail list"
msgstr "Largeur de la colonne du destinataire dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width of the date column in the mail list"
msgstr "Largeur de la colonne de date dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Date display format style in the mail list (standard, smart, short, full, datetime, iso, custom)"
msgstr "Style de format d'affichage de date dans la liste des courriels (standard, smart, short, full, datetime, iso, custom)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom strftime format pattern for dates in the mail list"
msgstr "Motif de format strftime personnalisé pour les dates dans la liste des courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Alignment of the date column in the mail list (right or left)"
msgstr "Alignement de la colonne de date dans la liste des courriels (droite ou gauche)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Active mail list column profile"
msgstr "Profil de colonne de liste de courriels actif"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Style of the email message header (modern card or classic tabular)"
msgstr "Style d'en-tête de message électronique (carte moderne ou tableau classique)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enabled direct action buttons in the mail message header action bar (left_group|right_group)"
msgstr "Boutons d'action directe activés dans la barre d'action d'en-tête de message (groupe_gauche|groupe_droite)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered items (quick filters, pinned folders, labels, and actions) in the middle-pane mail list action bar"
msgstr "Éléments ordonnés (filtres rapides, dossiers épinglés, étiquettes et actions) dans la barre d'action de la liste des courriels du panneau central"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Stable ordered mail list column identifiers"
msgstr "Identifiants ordonnés stables des colonnes de la liste de courriels"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Application color scheme (system, light, or dark)"
msgstr "Schéma de couleurs de l'application (système, clair ou sombre)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Location of module switcher buttons (top in header bar or bottom-left in sidebar)"
msgstr "Emplacement des boutons de changement de module (en haut dans la barre de titre ou en bas à gauche dans la barre latérale)"

#: data/com.martingawron.Meridian.gschema.xml:1 src/dialogs/preferences_dialog.rs:6929
msgid "Sign new messages by default"
msgstr "Signer les nouveaux messages par défaut"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default OpenPGP key fingerprint"
msgstr "Empreinte de clé OpenPGP par défaut"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default message security protocol (openpgp or smime)"
msgstr "Protocole de sécurité de message par défaut (openpgp ou smime)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default S/MIME signer certificate path"
msgstr "Chemin du certificat de signature S/MIME par défaut"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default S/MIME private key path"
msgstr "Chemin de la clé privée S/MIME par défaut"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "S/MIME recipient certificate paths separated by newlines"
msgstr "Chemins des certificats de destinataires S/MIME séparés par des retours à la ligne"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Optional S/MIME trust store certificate bundle path"
msgstr "Chemin optionnel du trousseau de certificats de confiance S/MIME"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail synchronization interval in seconds (0 disables automatic synchronization)"
msgstr "Intervalle de synchronisation des courriels en secondes (0 désactive la synchronisation automatique)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show unread email count in window title bar and tab"
msgstr "Afficher le nombre de courriels non lus dans la barre de titre de la fenêtre et l'onglet"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Maximum messages loaded per mail folder page"
msgstr "Nombre maximal de messages chargés par page de dossier de courriel"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Limit in-memory mail cache to reduce RAM usage"
msgstr "Limiter le cache des courriels en mémoire pour réduire l'utilisation de la mémoire vive"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When false, all locally cached message headers (up to 25,000 per folder) are loaded into memory for instant full-mailbox search and filtering. When true, only mail-sync-message-limit messages per folder are kept in memory initially."
msgstr "Lorsque faux, tous les en-têtes de messages mis en cache localement (jusqu'à 25 000 par dossier) sont chargés en mémoire pour une recherche et un filtrage instantanés dans toute la boîte. Lorsque vrai, seuls les messages correspondant à mail-sync-message-limit par dossier sont initialement conservés en mémoire."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Draft autosave interval in seconds (0 disables local autosave)"
msgstr "Intervalle d'enregistrement automatique des brouillons en secondes (0 désactive l'enregistrement automatique local)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Append the configured signature to new messages"
msgstr "Ajouter la signature configurée aux nouveaux messages"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Plain text signature for new messages"
msgstr "Signature au format texte brut pour les nouveaux messages"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Directory used for the portable local mail importer"
msgstr "Répertoire utilisé pour l'importateur portable de courriels locaux"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Directory used for the portable iCalendar importer"
msgstr "Répertoire utilisé pour l'importateur portable iCalendar"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Directory used for the portable vCard importer"
msgstr "Répertoire utilisé pour l'importateur portable vCard"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Include the original message in replies and forwards"
msgstr "Inclure le message d'origine dans les réponses et les transferts"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Quote style (blockquote or prefix)"
msgstr "Style de citation (bloc de citation ou préfixe)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail list sort field (date, subject, sender, unread, flagged, important, or attachments)"
msgstr "Champ de tri de la liste des courriels (date, objet, expéditeur, non lu, suivi, important ou pièces jointes)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Sort mail list in descending order"
msgstr "Trier la liste des courriels par ordre décroissant"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Group related messages into conversations"
msgstr "Grouper les messages associés en conversations"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Group similar standalone messages from the same sender with the same subject"
msgstr "Grouper les messages indépendants similaires provenant du même expéditeur avec le même objet"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When enabled alongside conversation grouping, recurring notifications or standalone messages sharing the same subject and sender are grouped together even without reply headers."
msgstr "Lorsque activé conjointement avec le groupement en conversations, les notifications récurrentes ou les messages indépendants partageant le même objet et le même expéditeur sont regroupés même sans en-tête de réponse."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show conversation thread in viewer as an accordion"
msgstr "Afficher le fil de conversation en accordéon dans la visionneuse"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When enabled, previous messages in a conversation thread are displayed in an expandable accordion inside the preview pane."
msgstr "Lorsque activé, les messages précédents d'un fil de conversation sont affichés dans un accordéon dépliable dans le panneau d'aperçu."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Portable custom folder sibling sort order"
msgstr "Ordre de tri des dossiers frères personnalisés portables"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "JSON map of stable local or loaded remote folder identifiers to their explicit sibling order."
msgstr "Correspondance JSON des identifiants de dossiers locaux stables ou distants chargés vers leur ordre explicite de dossiers frères."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Expanded mail folder and account identifiers"
msgstr "Identifiants des dossiers de courriel et comptes développés"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "List of mail account and folder identifiers that are currently expanded in the folder tree."
msgstr "Liste des identifiants de comptes et de dossiers de courriel actuellement développés dans l'arborescence des dossiers."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show locally deleted messages with a line through them"
msgstr "Afficher les messages supprimés localement barrés d'un trait"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Move deleted messages to Trash instead of deleting permanently"
msgstr "Déplacer les messages supprimés vers la corbeille au lieu de les supprimer définitivement"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When enabled, pressing Delete or clicking the delete action moves selected messages directly to the Trash folder without a confirmation dialog, unless they are already in Trash."
msgstr "Lorsque activé, appuyer sur Supprimer ou cliquer sur l'action de suppression déplace directement les messages sélectionnés vers le dossier Corbeille sans boîte de dialogue de confirmation, sauf s'ils s'y trouvent déjà."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Initial task filter (including date, status, category, and attachment filters)"
msgstr "Filtre de tâches initial (incluant les filtres de date, d'état, de catégorie et de pièce jointe)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Supported values include all, today, next-7, next-30, next-365, important, overdue, in-progress, cancelled, completed, uncompleted, scheduled, no-due, with-attachments, started, and without-category."
msgstr "Les valeurs prises en charge incluent all, today, next-7, next-30, next-365, important, overdue, in-progress, cancelled, completed, uncompleted, scheduled, no-due, with-attachments, started et without-category."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Selected task category filter"
msgstr "Filtre de catégorie de tâches sélectionné"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "An empty value shows every category. The value is a validated category name and is combined with the task view filter."
msgstr "Une valeur vide affiche toutes les catégories. La valeur est un nom de catégorie validé et est combinée au filtre de vue des tâches."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Task search mode (any field, summary, description, or advanced)"
msgstr "Mode de recherche des tâches (tout champ, résumé, description ou avancé)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Any-field, summary, and description modes search all terms with AND semantics. Advanced mode supports field predicates."
msgstr "Les modes tout champ, résumé et description recherchent tous les termes avec la sémantique ET. Le mode avancé prend en charge les prédicats de champ."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Selected task source filter"
msgstr "Filtre de source de tâches sélectionné"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Task list sort field (due, title, or priority)"
msgstr "Champ de tri de la liste des tâches (échéance, titre ou priorité)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Sort tasks in descending order"
msgstr "Trier les tâches par ordre décroissant"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Memo list sort field (updated, title, or source)"
msgstr "Champ de tri de la liste des mémos (mis à jour, titre ou source)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Selected memo source filter"
msgstr "Filtre de source de mémos sélectionné"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Sort memos in descending order"
msgstr "Trier les mémos par ordre décroissant"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Memo search mode (summary, description, any field, or advanced)"
msgstr "Mode de recherche des mémos (résumé, description, tout champ ou avancé)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Advanced memo search accepts only field:value terms joined by AND. Supported fields are summary, description, category, source, and url."
msgstr "La recherche avancée de mémos accepte uniquement des termes champ:valeur reliés par ET. Les champs pris en charge sont summary, description, category, source et url."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Memo category filter"
msgstr "Filtre de catégorie de mémos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Use any, without, or a validated category name."
msgstr "Utiliser any, without ou un nom de catégorie validé."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the memo preview"
msgstr "Afficher l'aperçu du mémo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the memos toolbar"
msgstr "Afficher la barre d'outils des mémos"

#: data/com.martingawron.Meridian.gschema.xml:1 src/views/memos_page.rs:2339
msgid "Memo preview orientation"
msgstr "Orientation de l'aperçu du mémo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Horizontal memo preview divider position"
msgstr "Position du séparateur horizontal d'aperçu du mémo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Vertical memo preview divider position"
msgstr "Position du séparateur vertical d'aperçu du mémo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the task preview"
msgstr "Afficher l'aperçu de la tâche"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the tasks toolbar"
msgstr "Afficher la barre d'outils des tâches"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Task preview orientation"
msgstr "Orientation de l'aperçu de la tâche"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Horizontal task preview divider position"
msgstr "Position du séparateur horizontal d'aperçu de la tâche"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Vertical task preview divider position"
msgstr "Position du séparateur vertical d'aperçu de la tâche"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Autocomplete length"
msgstr "Longueur avant complétion automatique"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "The number of characters that must be typed before Meridian will attempt to autocomplete."
msgstr "Le nombre de caractères devant être saisis avant que Meridian tente la complétion automatique."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show autocompleted name with an address"
msgstr "Afficher le nom autocomplété avec une adresse"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether force showing the mail address with the name of the autocompleted contact in the entry."
msgstr "Indique s’il faut forcer l’affichage de l’adresse électronique avec le nom du contact autocomplété dans la zone de saisie."

#: data/com.martingawron.Meridian.gschema.xml:1 src/dialogs/preferences_dialog.rs:3131
msgid "Address book sources for autocompletion"
msgstr "Sources de carnets d'adresses pour l'autocomplétion"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Comma-separated list of address book source UIDs enabled for autocompletion, or empty for all enabled books."
msgstr "Liste séparée par des virgules des UID de sources de carnets d'adresses activées pour l'autocomplétion, ou vide pour tous les carnets activés."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable address formatting"
msgstr "Activer le formatage d’adresse"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether addresses should be formatted according to standard in their destination country."
msgstr "Indique si les adresses doivent être formatées selon la norme de leur pays de destination."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show maps in contact preview"
msgstr "Afficher les cartes dans l'aperçu du contact"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to show maps in the contact preview pane."
msgstr "Indique s'il faut afficher les cartes dans le panneau d'aperçu du contact."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Preview Personal information before Work information"
