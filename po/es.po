#: data/com.martingawron.Meridian.Calendar.desktop.in:2 data/com.martingawron.Meridian.desktop.in:2 data/com.martingawron.Meridian.metainfo.xml.in:1
msgid "Meridian"
msgstr "Meridian"

#: data/com.martingawron.Meridian.Calendar.desktop.in:3
msgid "Calendar and Appointments"
msgstr "Calendario y citas"

#: data/com.martingawron.Meridian.Calendar.desktop.in:4 data/com.martingawron.Meridian.desktop.in:22 src/action_contract.rs:208 src/action_contract.rs:601 and 24 more
msgid "Calendar"
msgstr "Calendario"

#: data/com.martingawron.Meridian.desktop.in:3
msgid "Mail, Calendar and Contacts"
msgstr "Correo, calendario y contactos"

#: data/com.martingawron.Meridian.desktop.in:4
msgid "Groupware Client"
msgstr "Cliente de software colaborativo"

#: data/com.martingawron.Meridian.desktop.in:10
msgid "mail;email;calendar;contacts;groupware;exchange;ews;imap;"
msgstr "correo;correo-e;calendario;contactos;software colaborativo;exchange;ews;imap;"

#: data/com.martingawron.Meridian.desktop.in:18 src/dialogs/drafts_dialog.rs:73 src/dialogs/shortcuts_dialog.rs:268
msgid "New Message"
msgstr "Mensaje nuevo"

#: data/com.martingawron.Meridian.desktop.in:26 src/action_contract.rs:209 src/action_contract.rs:607 src/dialogs/account_setup_dialog.rs:621 and 16 more
msgid "Contacts"
msgstr "Contactos"

#: data/com.martingawron.Meridian.desktop.in:30 src/dialogs/preferences_dialog.rs:8416 src/dialogs/shortcuts_dialog.rs:363
msgid "Tasks & Memos"
msgstr "Tareas y notas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default window width"
msgstr "Anchura predeterminada de la ventana"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default window height"
msgstr "Altura predeterminada de la ventana"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Window maximized state"
msgstr "Estado maximizado de la ventana"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Currently selected view tab (mail, calendar, contacts, tasks, memos)"
msgstr "Pestaña de vista seleccionada actualmente (correo, calendario, contactos, tareas, notas)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default mail account or EDS source UID"
msgstr "Cuenta de correo predeterminada o UID de origen EDS"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS calendar, task, or memo source UID"
msgstr "UID de origen de calendario, tarea o nota EDS predeterminado"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS task list source UID"
msgstr "UID de origen de lista de tareas EDS predeterminado"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS memo list source UID"
msgstr "UID de origen de lista de notas EDS predeterminado"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default EDS address book source UID"
msgstr "UID de origen de libreta de direcciones EDS predeterminado"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default calendar view (day, week, workweek, month, agenda, year, or list)"
msgstr "Vista de calendario predeterminada (día, semana, semana laboral, mes, agenda, año o lista)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Intervals shown in day and workweek views in minutes (5, 10, 15, 30, or 60)"
msgstr "Intervalos mostrados en las vistas de día y semana laboral en minutos (5, 10, 15, 30 o 60)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Compress weekends in month view"
msgstr "Comprimir fines de semana en la vista mensual"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether the all-day events header is collapsed in day, week, and workweek views"
msgstr "Indica si la cabecera de eventos de todo el día está contraída en las vistas de día, semana y semana laboral"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Scroll month view by a week instead of a month"
msgstr "Desplazar la vista mensual por semanas en lugar de meses"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Animate month view scrolling"
msgstr "Animar el desplazamiento de la vista mensual"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Smoothly slide rows when scrolling weeks in month view. Disabled automatically when system animations are reduced."
msgstr "Deslizar suavemente las filas al desplazarse por semanas en la vista mensual. Se desactiva automáticamente cuando se reducen las animaciones del sistema."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of weeks shown in month view (5 for compact, 6 to display all months completely)"
msgstr "Número de semanas mostradas en la vista mensual (5 para compacta, 6 para mostrar todos los meses por completo)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Dim past calendar events"
msgstr "Atenuar eventos pasados del calendario"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Display past events semi-transparently to distinguish them from upcoming events."
msgstr "Mostrar eventos pasados semitransparentes para distinguirlos de los próximos eventos."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Scaling factor for calendar event chips"
msgstr "Factor de escala para las fichas de eventos del calendario"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Multiplier for calendar event chip height, spacing, and typography."
msgstr "Multiplicador para la altura, el espaciado y la tipografía de las fichas de eventos del calendario."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Second time zone for day and workweek views"
msgstr "Segunda zona horaria para las vistas de día y semana laboral"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Recently used second time zones"
msgstr "Segundas zonas horarias usadas recientemente"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "First weekday shown in calendar grids (monday or sunday)"
msgstr "Primer día de la semana mostrado en las cuadrículas del calendario (lunes o domingo)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Working weekdays used by the workweek calendar view"
msgstr "Días laborales de la semana usados por la vista de semana laboral del calendario"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Start of the working day in minutes after midnight"
msgstr "Inicio de la jornada laboral en minutos después de la medianoche"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "End of the working day in minutes after midnight"
msgstr "Fin de la jornada laboral en minutos después de la medianoche"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default event reminder in minutes before the event"
msgstr "Recordatorio predeterminado de eventos en minutos antes del evento"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Action when clicking a free calendar time slot ('select' to highlight and show draft, 'create' to directly open event editor)"
msgstr "Acción al pulsar en un intervalo de tiempo libre del calendario ('select' para resaltar y mostrar borrador, 'create' para abrir directamente el editor de eventos)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to set a default reminder for appointments"
msgstr "Indica si debe establecer un recordatorio predeterminado para las citas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of units for determining a default reminder"
msgstr "Número de unidades para determinar un recordatorio predeterminado"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Units for a default reminder, minutes, hours or days"
msgstr "Unidades para un recordatorio predeterminado: minutos, horas o días"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to set a reminder for birthdays and anniversaries"
msgstr "Indica si debe establecer un recordatorio para cumpleaños y aniversarios"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of units for determining a birthday and anniversary reminder"
msgstr "Número de unidades para determinar un recordatorio de cumpleaños y aniversarios"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Units for birthday and anniversary reminder, minutes, hours or days"
msgstr "Unidades para el recordatorio de cumpleaños y aniversarios: minutos, horas o días"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to hide completed tasks in the tasks view"
msgstr "Indica si debe ocultar las tareas terminadas en la vista de tareas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Units for determining when to hide completed tasks, minutes, hours or days"
msgstr "Unidades para determinar cuándo ocultar tareas completadas: minutos, horas o días"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Number of units for determining when to hide completed tasks"
msgstr "Número de unidades para determinar cuándo ocultar tareas completadas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to hide cancelled tasks in the tasks view"
msgstr "Indica si deben ocultar las tareas canceladas en la vista de tareas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to hide cancelled events in the calendar view"
msgstr "Indica si deben ocultar los eventos cancelados en la vista de tareas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show desktop notifications for local reminders"
msgstr "Mostrar notificaciones de escritorio para recordatorios locales"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Play sound when reminders are due"
msgstr "Reproducir sonido cuando venzan los recordatorios"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to play an audible alert when a calendar or task reminder is due."
msgstr "Indica si se debe reproducir una alerta sonora cuando venza un recordatorio de calendario o de tarea."

#: data/com.martingawron.Meridian.gschema.xml:1 src/dialogs/preferences_dialog.rs:6532
msgid "Show reminders in notification tray only"
msgstr "Mostrar recordatorios solo en el área de notificación"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When set to true, reminders are shown only as desktop notifications; when false, the reminders window is presented immediately."
msgstr "Cuando se establece a «true», los recordatorios solo se muestran como notificaciones de escritorio; cuando es «false», la ventana de recordatorios se presenta inmediatamente."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ask before destructive actions"
msgstr "Preguntar antes de realizar acciones destructivas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show ISO week numbers in calendar views"
msgstr "Mostrar números de semana ISO en las vistas de calendario"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden calendar source UIDs"
msgstr "UID de orígenes de calendario ocultos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden task list source UIDs"
msgstr "UID de orígenes de listas de tareas ocultas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden memo list source UIDs"
msgstr "UID de orígenes de listas de notas ocultas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden address book source UIDs"
msgstr "UID de orígenes de libretas de direcciones ocultas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden calendar source groups"
msgstr "Grupos de orígenes de calendario ocultos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for calendar source groups"
msgstr "Orden de visualización personalizado para grupos de orígenes de calendario"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden task list source groups"
msgstr "Grupos de orígenes de listas de tareas ocultas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for task list source groups"
msgstr "Orden de visualización personalizado para grupos de orígenes de listas de tareas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden memo list source groups"
msgstr "Grupos de orígenes de listas de notas ocultas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for memo list source groups"
msgstr "Orden de visualización personalizado para grupos de orígenes de listas de notas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Hidden address book source groups"
msgstr "Grupos de orígenes de libretas de direcciones ocultas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom display order for address book source groups"
msgstr "Orden de visualización personalizado para grupos de orígenes de libretas de direcciones"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Calendar date display format (locale, german, iso, or us)"
msgstr "Formato de visualización de fecha del calendario (locale, german, iso o us)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Calendar time display format (locale, 24h, or 12h)"
msgstr "Formato de visualización de hora del calendario (locale, 24h o 12h)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Calendar display time zone (system, UTC, or an IANA identifier)"
msgstr "Zona horaria de visualización del calendario (sistema, UTC o un identificador IANA)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show Tasks and Memos pane in the Calendar view"
msgstr "Mostrar el panel de tareas y recordatorios en la vista de calendario"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width/position of the Tasks and Memos pane"
msgstr "Anchura/posición del panel de tareas y notas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show Memos section in the Calendar right sidebar"
msgstr "Mostrar sección de notas en la barra lateral derecha del calendario"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Place Appointment Details section above Tasks in the Calendar right sidebar"
msgstr "Colocar la sección Detalles de la cita encima de Tareas en la barra lateral derecha del calendario"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered panel layout and display modes (off, split, tab) for the Calendar right sidebar"
msgstr "Distribución y modos de visualización ordenados de los paneles (desactivado, dividido, pestaña) para la barra lateral derecha del calendario"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Secondary splitter position in the Calendar right sidebar when 3 sections are open"
msgstr "Posición del separador secundario en la barra lateral derecha del calendario cuando hay 3 secciones abiertas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show appointment details preview pane in the Agenda view"
msgstr "Mostrar panel de vista previa de detalles de la cita en la vista de Agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width/position of the Agenda appointment details preview pane"
msgstr "Anchura/posición del panel de vista previa de detalles de la cita de Agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show minimalist map preview when hovering over event locations"
msgstr "Mostrar vista previa minimalista del mapa al pasar el cursor sobre las ubicaciones de eventos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Open event locations in the configured map service on click"
msgstr "Abrir ubicaciones de eventos en el servicio de mapas configurado al pulsar"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Automatically load remote images in HTML emails"
msgstr "Cargar automáticamente imágenes remotas en correos HTML"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Keep mail views in portable offline mode"
msgstr "Mantener vistas de correo en modo portátil sin conexión"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Force dark colors in HTML email rendering"
msgstr "Forzar colores oscuros al renderizar correos HTML"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Adapt HTML email display to dark system theme"
msgstr "Adaptar la visualización del correo HTML al tema oscuro del sistema"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Render HTML mail bodies"
msgstr "Renderizar cuerpos de correo HTML"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Use HTML mode when composing new messages"
msgstr "Usar modo HTML al redactar mensajes nuevos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default character encoding for new composed messages"
msgstr "Codificación de caracteres predeterminada para mensajes nuevos redactados"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Request a read receipt for new messages"
msgstr "Solicitar acuse de recibo para mensajes nuevos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Preferred spell-checking languages (comma-separated, empty for system default)"
msgstr "Idiomas preferidos para corrección ortográfica (separados por comas, vacío para el predeterminado del sistema)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the From account selector in composer"
msgstr "Mostrar el selector de cuenta «De» en el redactor"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the Cc recipient entry in composer"
msgstr "Mostrar el campo de destinatario «Cc» en el redactor"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the Bcc recipient entry in composer"
msgstr "Mostrar el campo de destinatario «Cco» en el redactor"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the Reply-To entry in composer"
msgstr "Mostrar el campo «Responder a» en el redactor"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the formatting toolbar in composer"
msgstr "Mostrar la barra de herramientas de formato en el redactor"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Prompt for confirmation when sending a message with an empty subject"
msgstr "Pedir confirmación al enviar un mensaje sin asunto"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Prompt for confirmation when sending a message with only Bcc recipients"
msgstr "Pedir confirmación al enviar un mensaje solo con destinatarios Cco"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable inline spell-checking in composer"
msgstr "Activar corrección ortográfica en línea en el redactor"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default reply style (quoted, inline, or attach)"
msgstr "Estilo de respuesta predeterminado (citado, en línea o adjunto)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default forward style (attached, inline, or quoted)"
msgstr "Estilo de reenvío predeterminado (adjunto, en línea o citado)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Insert signature above quoted text when replying"
msgstr "Insertar firma encima del texto citado al responder"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Prepend signature dash separator (-- ) before signature text"
msgstr "Anteponer separador de guiones (-- ) antes del texto de la firma"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Insert signature separator line"
msgstr "Insertar línea separadora de firma"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom signature separator string"
msgstr "Cadena separadora de firma personalizada"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Track and suggest recently emailed recipients"
msgstr "Recordar y sugerir destinatarios contactados recientemente por correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to remember outgoing message recipients for autocomplete suggestions."
msgstr "Indica si se deben recordar los destinatarios de mensajes salientes para sugerencias de autocompletado."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Font family used for mail and composer text"
msgstr "Familia tipográfica usada para el texto del correo y del redactor"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Font size used for mail and composer text"
msgstr "Tamaño de tipografía usado para el texto del correo y del redactor"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Policy for loading remote images in HTML mail (never, always, sometimes)"
msgstr "Directiva para cargar imágenes remotas en correos HTML (nunca, siempre, a veces)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Preserve layout and display placeholder boxes for blocked remote images"
msgstr "Conservar diseño y mostrar cuadros marcadores de posición para imágenes remotas bloqueadas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mark a message as read when it is viewed"
msgstr "Marcar un mensaje como leído cuando se visualiza"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Delay in milliseconds before automatically marking a viewed message as read"
msgstr "Retardo en milisegundos antes de marcar automáticamente un mensaje visualizado como leído"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable caret navigation cursor in message viewer"
msgstr "Activar cursor de navegación por teclado en el visor de mensajes"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Spacebar pages down or advances to next unread message at end"
msgstr "La barra espaciadora baja una página o avanza al siguiente mensaje no leído al final"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Highlight nested quote levels with distinctive colors"
msgstr "Resaltar niveles de citas anidadas con colores distintivos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 1st citation level"
msgstr "Color del borde para el 1.er nivel de cita"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 2nd citation level"
msgstr "Color del borde para el 2.º nivel de cita"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 3rd citation level"
msgstr "Color del borde para el 3.er nivel de cita"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 4th citation level"
msgstr "Color del borde para el 4.º nivel de cita"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Border color for 5th citation level"
msgstr "Color del borde para el 5.º nivel de cita"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Collapse message viewer header block to compact form"
msgstr "Contraer el bloque de cabecera del visor de mensajes a una forma compacta"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show real absolute timestamp in message headers"
msgstr "Mostrar marca de tiempo absoluta real en las cabeceras de los mensajes"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mark a message as read when it is selected"
msgstr "Marcar un mensaje como leído cuando se selecciona"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Delay in milliseconds before automatically marking a selected message as read"
msgstr "Retardo en milisegundos antes de marcar automáticamente un mensaje seleccionado como leído"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the selected message preview pane"
msgstr "Mostrar el panel de vista previa del mensaje seleccionado"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show routine mail security status and details"
msgstr "Mostrar estado de seguridad de rutina y detalles del correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the complete RFC822 header block in the mail preview"
msgstr "Mostrar el bloque completo de cabeceras RFC822 en la vista previa del correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered normal message headers and their visibility"
msgstr "Cabeceras normales de mensaje ordenadas y su visibilidad"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Each entry contains a header field name and whether it is shown in the normal message header view. Disabled entries remain available in Preferences."
msgstr "Cada entrada contiene el nombre de un campo de cabecera e indica si se muestra en la vista normal de cabeceras del mensaje. Las entradas desactivadas siguen disponibles en Preferencias."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail folder selected when the application starts"
msgstr "Carpeta de correo seleccionada al iniciar la aplicación"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail layout arrangement"
msgstr "Disposición del diseño de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Arrangement of mail panes: 'vertical' (3-panel: folders, list, preview on right) or 'horizontal' (folders, list above, preview below). Legacy 'modern' and 'classic' are accepted for backwards compatibility."
msgstr "Disposición de los paneles de correo: «vertical» (3 paneles: carpetas, lista, vista previa a la derecha) u «horizontal» (carpetas, lista arriba, vista previa abajo). Se aceptan los valores heredados «modern» y «classic» por compatibilidad hacia atrás."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show today's to-do bar in mail view"
msgstr "Mostrar barra de tareas pendientes de hoy en la vista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show tasks in agenda sidebar"
msgstr "Mostrar tareas en la barra lateral de agenda"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width of today's to-do bar in mail view"
msgstr "Anchura de la barra de tareas pendientes de hoy en la vista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Vertical split position between events and tasks in mail agenda sidebar"
msgstr "Posición de división vertical entre eventos y tareas en la barra lateral de agenda de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Secondary splitter position in the Mail right sidebar when 3 sections are open"
msgstr "Posición del separador secundario en la barra lateral derecha de Correo cuando hay 3 secciones abiertas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered panel layout and display modes (off, split, tab, window) for the Mail right sidebar"
msgstr "Distribución y modos de visualización ordenados de los paneles (desactivado, dividido, pestaña, ventana) para la barra lateral derecha de Correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the mail toolbar"
msgstr "Mostrar la barra de herramientas de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show mark read/unread actions in mail toolbar"
msgstr "Mostrar acciones de marcar como leído/no leído en la barra de herramientas de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show mail and connection status information at the bottom"
msgstr "Mostrar información de estado del correo y la conexión en la parte inferior"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable developer log console in status bar"
msgstr "Activar consola de registro para desarrolladores en la barra de estado"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the mail folder sidebar"
msgstr "Mostrar la barra lateral de carpetas de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail folder sidebar width"
msgstr "Anchura de la barra lateral de carpetas de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Message preview divider in modern mail layout"
msgstr "Divisor de vista previa de mensajes en diseño moderno de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Message preview divider in classic mail layout"
msgstr "Divisor de vista previa de mensajes en diseño clásico de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail list density (compact, comfortable, or spacious)"
msgstr "Densidad de la lista de correo (compacta, cómoda o espaciosa)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show read/unread status indicator in the mail list"
msgstr "Mostrar indicador de estado leído/no leído en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show flagged/star indicator in the mail list"
msgstr "Mostrar indicador de destacado/estrella en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show follow-up flag/completed indicator in the mail list"
msgstr "Mostrar indicador de marca de seguimiento/completado en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show sender avatars in the mail list"
msgstr "Mostrar avatares de remitentes en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Fetch brand logos and domain favicons from the internet"
msgstr "Obtener logotipos de marcas e iconos de dominios de Internet"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to asynchronously query domain favicons and logos for known sender domains."
msgstr "Indica si se deben consultar de forma asíncrona iconos de dominio y logotipos para dominios de remitentes conocidos."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable unified inboxes and global smart folders in sidebar"
msgstr "Activar bandejas de entrada unificadas y carpetas inteligentes globales en la barra lateral"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to show aggregated Inboxes, Unread, and Flagged mail virtual folders in the sidebar."
msgstr "Indica si se deben mostrar carpetas virtuales agregadas de Bandeja de entrada, No leídos y Correos destacados en la barra lateral."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show sender names in the mail list"
msgstr "Mostrar nombres de remitentes en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show recipient names in the mail list"
msgstr "Mostrar nombres de destinatarios en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show message dates in the mail list"
msgstr "Mostrar fechas de mensajes en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show an attachment indicator in the mail list"
msgstr "Mostrar un indicador de archivos adjuntos en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show message preview text in the mail list"
msgstr "Mostrar texto de vista previa del mensaje en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show app-owned labels in the mail list"
msgstr "Mostrar etiquetas de la aplicación en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show pure email address instead of name in recipient column"
msgstr "Mostrar dirección de correo electrónica pura en lugar del nombre en la columna de destinatarios"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to show email addresses instead of display names in the recipient column."
msgstr "Indica si se deben mostrar direcciones de correo electrónico en lugar de nombres para mostrar en la columna de destinatarios."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "List of mail labels and their associated colors and tags"
msgstr "Lista de etiquetas de correo y sus colores y etiquetas asociados"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "List of labels known to the mail component. Each entry is in the format name:color[|tag]."
msgstr "Lista de etiquetas conocidas por el componente de correo. Cada entrada tiene el formato nombre:color[|etiqueta]."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show message sizes in the mail list"
msgstr "Mostrar tamaños de mensajes en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show follow-up due dates in the mail list"
msgstr "Mostrar fechas de vencimiento de seguimiento en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show message locations in the mail list"
msgstr "Mostrar ubicaciones de mensajes en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width of the sender column in the mail list"
msgstr "Anchura de la columna de remitente en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width of the recipient column in the mail list"
msgstr "Anchura de la columna de destinatario en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Width of the date column in the mail list"
msgstr "Anchura de la columna de fecha en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Date display format style in the mail list (standard, smart, short, full, datetime, iso, custom)"
msgstr "Estilo de formato de visualización de fecha en la lista de correo (estándar, inteligente, corto, completo, fecha y hora, iso, personalizado)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Custom strftime format pattern for dates in the mail list"
msgstr "Patrón de formato strftime personalizado para fechas en la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Alignment of the date column in the mail list (right or left)"
msgstr "Alineación de la columna de fecha en la lista de correo (derecha o izquierda)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Active mail list column profile"
msgstr "Perfil de columnas activo de la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Style of the email message header (modern card or classic tabular)"
msgstr "Estilo de la cabecera del mensaje de correo (tarjeta moderna o tabular clásico)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enabled direct action buttons in the mail message header action bar (left_group|right_group)"
msgstr "Botones de acción directa activados en la barra de acciones de cabecera de mensajes (grupo_izquierdo|grupo_derecho)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Ordered items (quick filters, pinned folders, labels, and actions) in the middle-pane mail list action bar"
msgstr "Elementos ordenados (filtros rápidos, carpetas fijadas, etiquetas y acciones) en la barra de acciones de la lista de correo del panel central"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Stable ordered mail list column identifiers"
msgstr "Identificadores estables ordenados de columnas de la lista de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Application color scheme (system, light, or dark)"
msgstr "Esquema de color de la aplicación (sistema, claro u oscuro)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Location of module switcher buttons (top in header bar or bottom-left in sidebar)"
msgstr "Ubicación de los botones de cambio de módulo (arriba en la barra de cabecera o abajo a la izquierda en la barra lateral)"

#: data/com.martingawron.Meridian.gschema.xml:1 src/dialogs/preferences_dialog.rs:6929
msgid "Sign new messages by default"
msgstr "Firmar mensajes nuevos de forma predeterminada"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default OpenPGP key fingerprint"
msgstr "Huella digital de clave OpenPGP predeterminada"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default message security protocol (openpgp or smime)"
msgstr "Protocolo de seguridad de mensajes predeterminado (openpgp o smime)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default S/MIME signer certificate path"
msgstr "Ruta predeterminada del certificado del firmante S/MIME"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Default S/MIME private key path"
msgstr "Ruta predeterminada de la clave privada S/MIME"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "S/MIME recipient certificate paths separated by newlines"
msgstr "Rutas de certificados de destinatarios S/MIME separadas por saltos de línea"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Optional S/MIME trust store certificate bundle path"
msgstr "Ruta opcional del paquete de certificados del almacén de confianza S/MIME"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail synchronization interval in seconds (0 disables automatic synchronization)"
msgstr "Intervalo de sincronización de correo en segundos (0 desactiva la sincronización automática)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show unread email count in window title bar and tab"
msgstr "Mostrar recuento de correos no leídos en la barra de título de la ventana y en la pestaña"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Maximum messages loaded per mail folder page"
msgstr "Mensajes máximos cargados por página de carpeta de correo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Limit in-memory mail cache to reduce RAM usage"
msgstr "Limitar la caché de correo en memoria para reducir el uso de RAM"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When false, all locally cached message headers (up to 25,000 per folder) are loaded into memory for instant full-mailbox search and filtering. When true, only mail-sync-message-limit messages per folder are kept in memory initially."
msgstr "Cuando es «false», todas las cabeceras de mensajes en caché local (hasta 25 000 por carpeta) se cargan en memoria para búsqueda y filtrado instantáneos en todo el buzón. Cuando es «true», inicialmente solo se mantienen en memoria los mensajes indicados por mail-sync-message-limit por carpeta."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Draft autosave interval in seconds (0 disables local autosave)"
msgstr "Intervalo de guardado automático de borradores en segundos (0 desactiva el guardado automático local)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Append the configured signature to new messages"
msgstr "Añadir la firma configurada a los mensajes nuevos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Plain text signature for new messages"
msgstr "Firma de texto sin formato para mensajes nuevos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Directory used for the portable local mail importer"
msgstr "Directorio usado para el importador de correo local portátil"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Directory used for the portable iCalendar importer"
msgstr "Directorio usado para el importador iCalendar portátil"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Directory used for the portable vCard importer"
msgstr "Directorio usado para el importador vCard portátil"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Include the original message in replies and forwards"
msgstr "Incluir el mensaje original en respuestas y reenvíos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Quote style (blockquote or prefix)"
msgstr "Estilo de cita (bloque de cita o prefijo)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Mail list sort field (date, subject, sender, unread, flagged, important, or attachments)"
msgstr "Campo de ordenación de la lista de correo (fecha, asunto, remitente, no leído, destacado, importante o adjuntos)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Sort mail list in descending order"
msgstr "Ordenar lista de correo en orden descendente"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Group related messages into conversations"
msgstr "Agrupar mensajes relacionados en conversaciones"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Group similar standalone messages from the same sender with the same subject"
msgstr "Agrupar mensajes independientes similares del mismo remitente con el mismo asunto"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When enabled alongside conversation grouping, recurring notifications or standalone messages sharing the same subject and sender are grouped together even without reply headers."
msgstr "Cuando se activa junto con la agrupación por conversaciones, las notificaciones periódicas o mensajes independientes que comparten el mismo asunto y remitente se agrupan aunque no tengan cabeceras de respuesta."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show conversation thread in viewer as an accordion"
msgstr "Mostrar hilo de conversación en el visor como un acordeón"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When enabled, previous messages in a conversation thread are displayed in an expandable accordion inside the preview pane."
msgstr "Cuando se activa, los mensajes anteriores en un hilo de conversación se muestran en un acordeón desplegable dentro del panel de vista previa."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Portable custom folder sibling sort order"
msgstr "Orden de hermanos personalizado portátil de carpetas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "JSON map of stable local or loaded remote folder identifiers to their explicit sibling order."
msgstr "Mapa JSON de identificadores estables de carpetas locales o remotas cargadas respecto a su orden explícito de hermanos."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Expanded mail folder and account identifiers"
msgstr "Identificadores de carpetas y cuentas de correo desplegadas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "List of mail account and folder identifiers that are currently expanded in the folder tree."
msgstr "Lista de identificadores de cuentas y carpetas de correo que están actualmente desplegadas en el árbol de carpetas."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show locally deleted messages with a line through them"
msgstr "Mostrar mensajes eliminados localmente tachados con una línea"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Move deleted messages to Trash instead of deleting permanently"
msgstr "Mover mensajes eliminados a la Papelera en lugar de eliminarlos permanentemente"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "When enabled, pressing Delete or clicking the delete action moves selected messages directly to the Trash folder without a confirmation dialog, unless they are already in Trash."
msgstr "Cuando se activa, al pulsar Supr o la acción de eliminar, los mensajes seleccionados se mueven directamente a la carpeta Papelera sin cuadro de diálogo de confirmación, a menos que ya estén en la Papelera."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Initial task filter (including date, status, category, and attachment filters)"
msgstr "Filtro inicial de tareas (incluye filtros de fecha, estado, categoría y archivos adjuntos)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Supported values include all, today, next-7, next-30, next-365, important, overdue, in-progress, cancelled, completed, uncompleted, scheduled, no-due, with-attachments, started, and without-category."
msgstr "Los valores admitidos incluyen all, today, next-7, next-30, next-365, important, overdue, in-progress, cancelled, completed, uncompleted, scheduled, no-due, with-attachments, started y without-category."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Selected task category filter"
msgstr "Filtro de categoría de tareas seleccionado"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "An empty value shows every category. The value is a validated category name and is combined with the task view filter."
msgstr "Un valor vacío muestra todas las categorías. El valor es un nombre de categoría validado y se combina con el filtro de vista de tareas."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Task search mode (any field, summary, description, or advanced)"
msgstr "Modo de búsqueda de tareas (cualquier campo, resumen, descripción o avanzado)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Any-field, summary, and description modes search all terms with AND semantics. Advanced mode supports field predicates."
msgstr "Los modos de cualquier campo, resumen y descripción buscan todos los términos con semántica AND. El modo avanzado admite predicados de campos."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Selected task source filter"
msgstr "Filtro de origen de tareas seleccionado"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Task list sort field (due, title, or priority)"
msgstr "Campo de ordenación de la lista de tareas (vencimiento, título o prioridad)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Sort tasks in descending order"
msgstr "Ordenar tareas en orden descendente"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Memo list sort field (updated, title, or source)"
msgstr "Campo de ordenación de la lista de notas (actualizado, título u origen)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Selected memo source filter"
msgstr "Filtro de origen de notas seleccionado"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Sort memos in descending order"
msgstr "Ordenar notas en orden descendente"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Memo search mode (summary, description, any field, or advanced)"
msgstr "Modo de búsqueda de notas (resumen, descripción, cualquier campo o avanzado)"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Advanced memo search accepts only field:value terms joined by AND. Supported fields are summary, description, category, source, and url."
msgstr "La búsqueda avanzada de notas solo acepta términos campo:valor unidos por AND. Los campos admitidos son summary, description, category, source y url."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Memo category filter"
msgstr "Filtro de categoría de notas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Use any, without, or a validated category name."
msgstr "Use any, without o un nombre de categoría validado."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the memo preview"
msgstr "Mostrar la vista previa de la nota"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the memos toolbar"
msgstr "Mostrar la barra de herramientas de notas"

#: data/com.martingawron.Meridian.gschema.xml:1 src/views/memos_page.rs:2339
msgid "Memo preview orientation"
msgstr "Orientación de la vista previa de notas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Horizontal memo preview divider position"
msgstr "Posición horizontal del divisor de vista previa de notas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Vertical memo preview divider position"
msgstr "Posición vertical del divisor de vista previa de notas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the task preview"
msgstr "Mostrar la vista previa de la tarea"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show the tasks toolbar"
msgstr "Mostrar la barra de herramientas de tareas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Task preview orientation"
msgstr "Orientación de la vista previa de tareas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Horizontal task preview divider position"
msgstr "Posición horizontal del divisor de vista previa de tareas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Vertical task preview divider position"
msgstr "Posición vertical del divisor de vista previa de tareas"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Autocomplete length"
msgstr "Longitud del autocompletado"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "The number of characters that must be typed before Meridian will attempt to autocomplete."
msgstr "El número de caracteres que se deben escribir antes de que Meridian intente autocompletar."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show autocompleted name with an address"
msgstr "Mostrar el nombre autocompletado con la dirección"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether force showing the mail address with the name of the autocompleted contact in the entry."
msgstr "Indica si se debe forzar el mostrado de la dirección de corre-e con el nombre autocompletado del contacto en la entrada."

#: data/com.martingawron.Meridian.gschema.xml:1 src/dialogs/preferences_dialog.rs:3131
msgid "Address book sources for autocompletion"
msgstr "Orígenes de libretas de direcciones para autocompletado"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Comma-separated list of address book source UIDs enabled for autocompletion, or empty for all enabled books."
msgstr "Lista separada por comas de UID de orígenes de libreta de direcciones activados para autocompletado, o vacío para todas las libretas activadas."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Enable address formatting"
msgstr "Activar formateado de direcciones"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether addresses should be formatted according to standard in their destination country."
msgstr "Indica si las direcciones deben formatearse según el estándar de su país de destino."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show maps in contact preview"
msgstr "Mostrar mapas en la vista previa del contacto"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Whether to show maps in the contact preview pane."
msgstr "Indica si se deben mostrar mapas en el panel de vista previa del contacto."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Preview Personal information before Work information"
msgstr "Previsualizar la información personal antes de la información de trabajo"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Show Personal information before Work information in the contact preview."
msgstr "Mostrar información personal antes de la información laboral en la vista previa del contacto."

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Where to open contact locations"
msgstr "Dónde abrir las ubicaciones de los contactos"

#: data/com.martingawron.Meridian.gschema.xml:1
msgid "Currently supported values are 'openstreetmap' and 'google'; if unknown set, uses 'openstreetmap'."
msgstr "Los valores admitidos actualmente son 'openstreetmap' y 'google'; si se establece uno desconocido, se usa 'openstreetmap'."

