<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.martingawron.Meridian</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Meridian</name>
  <summary>Modern, fast Mail, Calendar and Groupware Client</summary>

  <description>
    <p>
      Meridian is a modern, fast GTK4 / libadwaita groupware client for
      email, calendar, contacts, tasks, and notes, powered by Evolution Data Server (EDS).
    </p>
    <ul>
      <li>Fast sandboxed WebKitGTK 6.0 HTML mail viewing</li>
      <li>Privacy-first remote image blocking and OpenPGP/S-MIME support</li>
      <li>Integrated account, calendar, task, memo and address-book interfaces</li>
      <li>Offline and local EML, Maildir and mbox ingestion</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.martingawron.Meridian.desktop</launchable>
  <url type="homepage">https://github.com/megawron/meridian</url>
  <url type="bugtracker">https://github.com/megawron/meridian/issues</url>
  <url type="vcs-browser">https://github.com/megawron/meridian</url>
  <developer id="io.github.megawron">
    <name>megawron</name>
  </developer>
  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.1.0" date="2026-11-03">
      <description>
        <p>Initial release of Meridian featuring GTK4/Libadwaita mail, calendar, contacts, tasks, and memos powered by Evolution Data Server and WebKitGTK 6.0.</p>
      </description>
    </release>
  </releases>
</component>
