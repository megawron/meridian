<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.martingawron.Meridian</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Meridian</name>
  <summary>Modern, fast Mail, Calendar and Groupware Client</summary>

  <description>
    <p>
      Meridian is a modern, fast GTK4 / libadwaita groupware client for
      email, calendar, contacts, tasks, and notes, powered by Evolution Data Server (EDS).
    </p>
    <ul>
      <li>Fast sandboxed WebKitGTK 6.0 HTML mail viewing</li>
      <li>Privacy-first remote image blocking and OpenPGP/S-MIME groundwork</li>
      <li>Integrated account, calendar, task, memo and address-book interfaces</li>
      <li>Offline and local EML, Maildir and mbox ingestion</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.martingawron.Meridian.desktop</launchable>
  <url type="homepage">https://gitlab.gnome.org/GNOME/meridian</url>
  <url type="bugtracker">https://gitlab.gnome.org/GNOME/meridian/-/issues</url>
  <developer_name>megawron &amp; GNOME Community</developer_name>

  <releases>
    <release version="0.1.0" date="2026-08-10">
      <description>
        <p>Initial GTK4/libadwaita technical preview with local mail ingestion, EDS source discovery and WebKitGTK 6.0 rendering.</p>
      </description>
    </release>
  </releases>
</component>
