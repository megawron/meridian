<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.martingawron.Meridian</id>
  <pkgname>meridian</pkgname>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Meridian</name>
  <summary>Mail, calendar, contacts, and tasks for GNOME</summary>

  <description>
    <p>
      Meridian is an all-in-one mail, calendar, contacts, and tasks application
      designed for the GNOME desktop, built with Rust, GTK 4, libadwaita, and WebKitGTK.
    </p>
    <p>
      Built on top of Evolution Data Server (EDS), Meridian works out of the box
      with your existing system accounts, local folders, and GNOME Online Accounts.
    </p>
  </description>

  <launchable type="desktop-id">com.martingawron.Meridian.desktop</launchable>
  <translation type="gettext">meridian</translation>
  <url type="homepage">https://github.com/megawron/meridian</url>
  <url type="bugtracker">https://github.com/megawron/meridian/issues</url>
  <url type="vcs-browser">https://github.com/megawron/meridian</url>
  <url type="contact">https://martingawron.com</url>
  <developer id="com.martingawron">
    <name>Martin Gawron</name>
  </developer>
  <developer_name>Martin Gawron</developer_name>

  <branding>
    <color type="primary" scheme_preference="light">#d6e6ff</color>
    <color type="primary" scheme_preference="dark">#1c3b6e</color>
  </branding>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>

  <categories>
    <category>Office</category>
    <category>Email</category>
    <category>Calendar</category>
    <category>ContactManagement</category>
  </categories>

  <keywords>
    <keyword>mail</keyword>
    <keyword>email</keyword>
    <keyword>calendar</keyword>
    <keyword>contacts</keyword>
    <keyword>tasks</keyword>
    <keyword>evolution</keyword>
    <keyword>groupware</keyword>
  </keywords>

  <screenshots>
    <screenshot type="default">
      <caption>Unified mail workspace with threaded conversations, sandboxed HTML preview, and integrated agenda, tasks, and memos sidebar</caption>
      <image type="source" width="1920" height="1080">https://raw.githubusercontent.com/megawron/meridian/main/data/screenshots/mail.png</image>
    </screenshot>
    <screenshot>
      <caption>Calendar week view with multi-account schedules, event details, and integrated tasks</caption>
      <image type="source" width="1920" height="1080">https://raw.githubusercontent.com/megawron/meridian/main/data/screenshots/calendar-week.png</image>
    </screenshot>
    <screenshot>
      <caption>Calendar month view with multi-day events and mini-calendar navigation</caption>
      <image type="source" width="1920" height="1080">https://raw.githubusercontent.com/megawron/meridian/main/data/screenshots/calendar-month.png</image>
    </screenshot>
    <screenshot>
      <caption>Calendar year planner view with interactive day timeline preview</caption>
      <image type="source" width="1920" height="1080">https://raw.githubusercontent.com/megawron/meridian/main/data/screenshots/calendar-year.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.3.0-beta.1" date="2026-11-10" type="development">
      <description>
        <p>Meridian 0.3.0-beta.1 improvements and fixes:</p>
        <ul>
          <li>Persistent "On This Computer" local mail tree with full right-click CRUD, custom subfolder hierarchy, and automatic filter rule target updates on rename</li>
          <li>Full account &amp; folder tree picker in the Filter Rule Editor across all online accounts and local folders, plus wildcard (*), regex, and All Messages matching</li>
          <li>GNOME HIG overhaul for Folder Properties dialog with custom icons, color swatches, retention policy, and quick filter rule creation</li>
          <li>Camel IMAP/Exchange folder creation, renaming, and deletion directly from the sidebar context menu, plus persistent expanded/collapsed sidebar state</li>
          <li>Default to Online Mode on first launch while persisting manual toggles, accompanied by a subtle header-bar Offline Mode indicator</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0-beta.1" date="2026-11-09" type="development">
      <description>
        <p>Meridian 0.2.0-beta.1 improvements and fixes:</p>
        <ul>
          <li>Multi-language localization support (English, German, Spanish, French, Korean, Simplified Chinese)</li>
          <li>Composer undo/redo history (Ctrl+Z / Ctrl+Y), fixed-width formatting dropdowns, font family preferences, blockquote toggling, and reply attribution/signature ordering</li>
          <li>Browser-style hovered link target preview pill in MailViewer and Composer</li>
          <li>Flatpak sandbox support for opening and downloading email attachments</li>
          <li>Consistent filtering of disabled GOA and EDS accounts across Mail, Calendar, Tasks, Memos, and Contacts</li>
          <li>Improved mail selection stability on background sync, thread root preview updates, and folder drag-and-drop highlighting</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0-beta.1" date="2026-11-04" type="development">
      <description>
        <p>Initial public beta release of Meridian:</p>
        <ul>
          <li>Unified mail workspace with threaded conversations, fast full-text search, OpenPGP and S/MIME support, and sandboxed HTML preview</li>
          <li>Multi-view calendar supporting Day, Work Week, Week, Month, Agenda, and Year (Planner, Grid, and Multi-Year) views</li>
          <li>Integrated Contacts, Tasks, and Memos with email-linked notes and a customizable right-hand sidebar</li>
          <li>Native Evolution Data Server (EDS) and GNOME Online Accounts integration</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
