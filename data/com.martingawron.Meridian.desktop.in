[Desktop Entry]
Name=Meridian
Comment=Mail, Calendar and Contacts
GenericName=Groupware Client
Exec=meridian %U
Icon=com.martingawron.Meridian
Terminal=false
Type=Application
Categories=GNOME;GTK;Office;Email;Calendar;ContactManagement;
Keywords=mail;email;calendar;contacts;groupware;exchange;ews;imap;
MimeType=x-scheme-handler/mailto;message/rfc822;text/vcard;text/directory;text/x-vcard;application/x-xpixmap;
Actions=NewMessage;calendar;OpenContacts;OpenTasks;
StartupNotify=true
StartupWMClass=com.martingawron.Meridian
X-GNOME-UsesNotifications=true

[Desktop Action NewMessage]
Name=New Message
Exec=meridian --compose

[Desktop Action calendar]
Name=Calendar
Exec=meridian --calendar

[Desktop Action OpenContacts]
Name=Contacts
Exec=meridian --contacts

[Desktop Action OpenTasks]
Name=Tasks & Memos
Exec=meridian --tasks
